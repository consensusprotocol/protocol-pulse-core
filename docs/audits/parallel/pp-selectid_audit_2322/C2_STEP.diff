+        out, calls = self.run_build(ms, {"a": 4}, alone=[None], layout="recap")
+        self.assertIsNone(out["package"])
+        self.assertNotIn("package_for", calls)
+        self.assertIn("no rating yet", out["moments"]["a"]["out"])
