+def et_day(now):
+    """The ET calendar day of the render clock (all times ET): the 'day' of one spotlight per channel per day."""
+    from zoneinfo import ZoneInfo
+    return now.astimezone(ZoneInfo("America/New_York")).strftime("%Y-%m-%d")
