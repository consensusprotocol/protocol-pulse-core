+            [v for m, o, t in left if o or t for v in [trim_variant(m, sources)] if v]
+        rec = dict(rec, candidates=len(ask), candidates_written=write_candidates(candidates_path, ask, ctx, build_name))
+    return {"index": index, "record": rec}
