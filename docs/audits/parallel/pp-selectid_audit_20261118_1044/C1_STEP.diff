+class TestRuling150ValueByHand(unittest.TestCase):
+    """RULING 150 (1) (orchestrator 10:40 ET Nov 18), applied BY HAND to the one exception pin: the exact closing line
+    the driver names (--value-soft-line) keeps its place in the never-empty pass when its MEASURED value verdict (ruling
+    91) is LOST, flagged 'The closing line may mostly restate the clips: "<line>"'. Any other line, an unmeasured
+    verdict, and the clean pass: unchanged."""
+    TICKER = {"kind": "ticker", "text": "S&P 500 Nasdaq Bitcoin", "whole_in_16x9": True, "in_9x16": "cut",
+              "covers_speaker": False}
+
+    def run_rig(self, line, measured=True):
+        import test_medley as TM
+        from test_moments import pm
+        ms = [pm("h", "A", 12.0), pm("x", "B", 14.0), pm("y", "C", 13.0)]
+        lost = {"adds": "yes", "no_restate": "no", "why": "it restates the clips"} if measured else {"measured": False}
+        r = TM.Rig(ms, ["h", "x", "y"], [(True, [], None, TM.Rig.LINE), (True, [], None, TM.Rig.LINE)], [None],
+                   visuals={"x": {"burned_in": [dict(self.TICKER)]}}, values=[dict(lost) for _ in range(6)],
+                   follow_up={"angles": [TM.angle(["h", "x", "y"], "h")]})
+        r.build_kw = {"never_empty": True}
+        with mock.patch.object(PK, "VALUE_SOFT_LINE", line):
+            return r.run()["package"]
+
+    def test_the_named_line_seals_flagged(self):
+        import test_medley as TM
+        pk = self.run_rig(TM.Rig.LINE)
+        self.assertIsNotNone(pk)
+        row = pk["gates"]["takeaway_value"]
+        self.assertEqual((row["status"], row["flags"], row["text"]), (
+            "FLAGGED", [f'The closing line may mostly restate the clips: "{TM.Rig.LINE}"'], TM.Rig.LINE))
+        self.assertEqual(PP.gate_problems(pk["gates"], PP.required_gates(pk)), [])
+
+    def test_the_clean_pass_never_takes_it(self):
+        import test_medley as TM
+        from test_moments import pm
+        ms = [pm("h", "A", 12.0), pm("x", "B", 14.0), pm("y", "C", 13.0)]           # nothing soft: the clean pass
+        r = TM.Rig(ms, ["h", "x", "y"], [(True, [], None, TM.Rig.LINE), (True, [], None, TM.Rig.LINE)], [None],
+                   values=[{"adds": "yes", "no_restate": "no", "why": "it restates the clips"} for _ in range(6)])
+        with mock.patch.object(PK, "VALUE_SOFT_LINE", TM.Rig.LINE):
+            self.assertIsNone(r.run()["package"])                                   # reaches the value gate: HARD
+
+    def test_any_other_line_or_no_verdict_stays_hard(self):
+        import test_medley as TM
+        self.assertIsNone(self.run_rig("A different closing line."))
+        self.assertIsNone(self.run_rig(None))
+        self.assertIsNone(self.run_rig(TM.Rig.LINE, measured=False))
+
+
