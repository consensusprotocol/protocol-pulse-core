+        rs = {("a", "q"): {"moment_id": "a", "scroll": 4, "alone": 5, "setup": 5, "rating": 4},
+              ("a~trim", "q"): {"moment_id": "a~trim", "scroll": 4, "alone": 4, "setup": 4, "rating": 4},
+              ("w", "q"): {"moment_id": "w", "scroll": 5, "alone": 5, "setup": 5, "rating": 5},   # a span of b
