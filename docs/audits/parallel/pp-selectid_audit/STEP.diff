@@ -0,0 +1,86 @@
+#!/usr/bin/env python3
+"""tests/select_by_id/proof/*.json (proof_saved_runs.py) -> the proof table in docs/audits/parallel/pp-selectid_PROOF.md
+(per run: groups, story calls / outcomes, line-up, ids resolve, eligibility re-check, claim; the preview's overlap with
+the approved passages). Usage: python3 tests/select_by_id/proof_table.py"""
+import glob
+import json
+import os
+from collections import Counter
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+REPO = os.path.dirname(os.path.dirname(HERE))
+OUT = os.path.join(REPO, "docs", "audits", "parallel", "pp-selectid_PROOF_TABLE.md")
+ORDER = ("fresh_20261112_050611", "fresh_20261111_190259", "fresh_20261111_213954", "fresh_20261112_001448", "fresh_20261112_013452",
+         "fresh_20261110_093150", "fresh_20261111_192645", "fresh_20261107_080503", "fresh_20261107_065702",
+         "fresh_20261106_213852", "pinned_20261111_172202")
+
+
+def story_outcomes(r):
+    c = Counter()
+    for g in r.get("groups") or []:
+        st = g.get("story") or {}
+        s = st.get("status")
+        if s == "accepted":
+            lo = g.get("lineup") or {}
+            s = "story; line-up " + ({"accepted": "ACCEPTED", "declined": "declined", "rejected": "rejected",
+                                      "model_error": "model error"}.get(lo.get("status"), "not asked (no word record)"))
+        c[s] += 1
+    return ", ".join(f"{n} {k}" for k, n in c.most_common())
+
+
+def main():
+    recs = {}
+    for p in glob.glob(os.path.join(HERE, "proof", "*.json")):
+        if os.path.basename(p) == "SPEND.json":
+            continue
+        r = json.load(open(p))
+        recs[r["run"]] = r
+    spend = json.load(open(os.path.join(HERE, "proof", "SPEND.json")))
+    lines = ["| run | groups screened 48h / 72h | story calls | outcomes per group | line-up | every id resolves | "
+             "line-up passes eligibility (re-check) | claim (verbatim source sentence) |",
+             "|---|---|---|---|---|---|---|---|"]
+    for name in ORDER:
