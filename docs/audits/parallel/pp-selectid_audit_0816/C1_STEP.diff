     return v
 
 
+REPOST_ALIGN_MIN = 0.80          # ruling 53: the share of the shorter moment's words that align in order
+
+
+def reposted_once(ms):
+    """RULING 53 (08:06 Nov 13): the same speech re-posted by a SECOND channel is ONE moment. Two moments on different
+    channels are the same speech when their canonical tokens (canon.canon_tokens, the one normal form) are equal, or
+    when an in-order alignment (difflib's matching blocks) covers at least REPOST_ALIGN_MIN of the shorter one's words.
+    Of each such group the ORIGINAL publisher's moment is kept: the earliest published_at (a moment with no readable
+    time is never preferred; a tie goes to the lower moment id). Its channel is the one credited, since only it plays.
+    -> (the moments kept, in their order, {copy's moment id: why})."""
+    import collections
+    import difflib
+    from datetime import datetime, timezone
+    import canon
+    toks = {m["moment_id"]: canon.canon_tokens(m.get("text") or "") for m in ms}
+
+    def at(m):                                    # the earliest readable publish time first; none is never first
+        try:
+            t = datetime.fromisoformat(str(m.get("published_at") or "").replace("Z", "+00:00"))
+        except ValueError:
+            t = None
+        if t is None or t.tzinfo is None:
+            return (1, 0.0, m["moment_id"])
+        return (0, t.astimezone(timezone.utc).timestamp(), m["moment_id"])
+
+    def same(a, b):
+        ta, tb = toks[a["moment_id"]], toks[b["moment_id"]]
+        if not ta or not tb:
+            return None
+        if ta == tb:
+            return "equal text after normalisation"
+        short = min(len(ta), len(tb))
+        if sum((collections.Counter(ta) & collections.Counter(tb)).values()) < REPOST_ALIGN_MIN * short:
+            return None                           # the shared words bound the aligned ones: 80 % is out of reach
+        hit = sum(x.size for x in difflib.SequenceMatcher(None, ta, tb, autojunk=False).get_matching_blocks())
+        return f"{hit} of the shorter's {short} words align in order" if hit >= REPOST_ALIGN_MIN * short else None
+    parent = {m["moment_id"]: m["moment_id"] for m in ms}
+
+    def root_of(x):
+        while parent[x] != x:
+            parent[x] = parent[parent[x]]
+            x = parent[x]
+        return x
+    how = {}
+    for i, a in enumerate(ms):
+        for b in ms[i + 1:]:
+            if a["channel_id"] == b["channel_id"]:
+                continue                                  # the rule is about a SECOND channel
+            w = same(a, b)
+            if w:
+                ra, rb = root_of(a["moment_id"]), root_of(b["moment_id"])
+                if ra != rb:
+                    parent[rb] = ra
+                how[(a["moment_id"], b["moment_id"])] = how[(b["moment_id"], a["moment_id"])] = w
+    groups = {}
+    for m in ms:
+        groups.setdefault(root_of(m["moment_id"]), []).append(m)
+    out, dup = [], {}
+    keep = {min(g, key=at)["moment_id"] for g in groups.values()}
+    by = {m["moment_id"]: m for m in ms}
+    for m in ms:
+        mid = m["moment_id"]
+        if mid in keep:
+            out.append(m)
+            continue
+        k = next(x for x in keep if root_of(x) == root_of(mid))
+        o = by[k]
+        dup[mid] = (f"the same speech as {k} ({o.get('channel_name') or o['channel_id']}, published "
+                    f"{o.get('published_at')}), re-posted by a second channel "
+                    f"({m.get('channel_name') or m['channel_id']}, published {m.get('published_at')}): "
+                    f"{how.get((k, mid)) or 'aligned through another copy'} (ruling 53: the original publisher's is kept "
+                    f"and credited)")
+    return out, dup
+
+
