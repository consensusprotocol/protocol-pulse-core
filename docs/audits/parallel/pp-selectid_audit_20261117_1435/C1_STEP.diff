+        self.assertEqual(PK.seg_marks([dict(self.H), dict(self.X, step_a_flags=["REFERENT_OUTSIDE", "UNCERTAIN"]),
+                                       dict(self.Y, edge_flags=["EDGE_IN"], stand_soft="why")]), 4)
+
+    def test_what_coherence_accepts(self):
