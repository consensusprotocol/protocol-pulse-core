+def _canon_to(ws, i):
+    """The last canonical token of the recogniser's words up to i ('to sixty-eight thousand.' -> '68000')."""
+    c = canon.canon_tokens(" ".join(w.get("text") or "" for w in ws[max(0, i - CANON_RUN + 1):i + 1]))
+    return c[-1] if c else None
