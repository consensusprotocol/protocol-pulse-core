+        self.assertEqual([x["slot"] for x in pk["lines"]], ["takeaway", "title", "caption"])
+        self.assertAlmostEqual(pk["runtime_s_estimate"], 39.0 + 8 / 2.5 + 1.0 + PK.FINAL_TAIL_S, places=2)
