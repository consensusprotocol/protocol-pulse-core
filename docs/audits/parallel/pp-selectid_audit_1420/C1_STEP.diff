+        CA.seed(reg, record(T0 + timedelta(hours=1), [t(["g", "h", "i"])]), "mid")
+        CA.outcome(reg["candidates"]["g+h+i"], "line", T0.isoformat(), "b")              # resting until T0 + 6 h
+        self.assertEqual([(k, f) for k, _, f in CA.due(reg, T0 + timedelta(hours=3))],
