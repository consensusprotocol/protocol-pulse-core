+
+    def test_run_due_stops_at_a_package_inside_the_judged_line_ups(self):
+        reg = CA.new_registry()
+        for h, lu in enumerate((["a", "b", "c"], ["d", "e", "f"], ["g", "h", "i"])):
+            CA.seed(reg, record(T0 + timedelta(hours=h), [t(lu)]), f"r{h}")
+        seen = []
+
+        def try_one(e, fresh, left):
