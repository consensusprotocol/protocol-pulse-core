+            with tempfile.TemporaryDirectory() as d:
+                r, b, j = self.named(d, held, GROK)
+                self.assertEqual((RY.ask_one(r, j, {"none": b.name}, cap_s=2.0), b.calls), ("stopped", 0))
+        with tempfile.TemporaryDirectory() as d:
