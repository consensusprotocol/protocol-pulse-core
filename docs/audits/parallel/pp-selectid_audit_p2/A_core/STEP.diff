+++ b/pipeline/package.py
@@ -0,0 +1,698 @@
+#!/usr/bin/env python3
+"""pipeline/package.py — STEP 2 PACKAGE + STEP 3 OPTIMISE (law L-q, '01:55'; laws L-s..L-w, '02:30'): the set of
+moments that makes the best 60-70 s video, the angle that ties them, and the PBX MAX VO. The moments need not share a
+development: under moments-first there is no same-event test at all (orchestrator 03:00).
+
+CODE (deterministic, law L-w 1):
+  usable()          moments a package may use: on screen eligible (word timing, law L-e), no hard-exclusion risk
+                    (L-u), not delivered in the previous 24 h (novelty, L-p), channel not opted out, <= 20 s (L-u),
+                    a time-sensitive moment only from a source <= TIME_SENSITIVE_H old (L-v 3)
+  candidate_sets()  hook + 2-3 clips, every segment from a DIFFERENT channel (L-u: one clip per channel per video;
+                    >= 2 channels follows), the runtime arithmetic: segments + VO + FIXED_S inside 60-70 s (L-o) with
+                    the VO's length as the slack (L-w 1); ranked by the moments' scores, topic diversity, at most one
+                    price prediction (L-u)
+WRITER (role "angle_write", law L-w 1: a frontier model until the A/B shows local meets the bar): picks one set, its
+  type ("story" when every segment states one development, else "moments"), the order (hook first), the angle, the VO
+  intro and bridges with word budgets computed by code, ONE title, ONE caption (L-t), each line citing moment ids.
+  The sign-off is code: the credit set, hook first (law L-a: credits = EDL set = spoken sign-off).
+GATES (both hard): vo_fidelity.check (deterministic + blind verdict on VO, title, caption; L-o 11, L-t) and
+  context_integrity.check (L-s). A VO failure: regenerate once with the violations, then a PLAIN factual VO (L-w 2:
+  "Next, <show> on <topic>."); a context failure: extend the clip backwards by whole sentences (<= 2) and check again,
+  or drop the MOMENT and repack from the next set; an exclusion failure drops the moment.
+OUTPUT pp.package/1 (contract in STATE): segments (moment ids, verbatim text, times), VO, title, caption, the hook's
+  first words, the checks, the model per artefact, dollars.
+"""
+import itertools
+import json
+import re
+import time
+
+import context_integrity as CI
+import eligibility as E
+import trend_brief as TB
+import vo_fidelity as VF
+
+SEG_MAX_S = 20.0                   # L-u: at most 20 s per source video
+N_CLIPS = (2, 3)                   # hook + 2-3 clips (eligibility.N_CLIPS)
+RUNTIME_S = E.RUNTIME_S            # L-o: 60-70 s, the one hard length rule
+WPS = 2.6                          # PBX MAX VO words per second: an ASSUMPTION until the render measures it
+SIGNOFF_WORDS = 18                 # the preview's sign-off ("Clips today from A, B, and C. Go follow them ...")
+FIXED_S = round(E.TAIL_S - SIGNOFF_WORDS / WPS, 2)   # credits card + outro + transitions without VO (~7.4 s)
+VO_S = (6.0, 22.0)                 # the VO's seconds (intro + bridges), the slack that lands the runtime
+TIME_SENSITIVE_H = 24.0            # L-v 3: 'today' / 'just' / a price level only from a source this fresh
+TOP_SETS = 6                       # sets offered to the writer
+PRESCREEN_N = 24                   # moments whose own context is screened (step A) before any writing
+PRESCREEN_BATCH = 8                # excerpts per step-A call
+MAX_HOOKS = 10
+PRICE_PREDICTIONS_MAX = 1          # L-u: at most one per video
+
+
+def channel_of(m):
+    return m["channel_id"]
+
+
+def usable(moments, ctx, delivered=(), optout=frozenset()):
+    out, why = [], {}
+    for m in moments:
+        mid = m["moment_id"]
+        if not m.get("on_screen_ok"):
+            why[mid] = "not eligible on screen: " + "; ".join(
+                f"{r}: {', '.join(v['reasons'])}" for r, v in (m.get("eligibility") or {}).items() if not v["ok"])
+        elif m.get("excluded"):
+            why[mid] = f"hard exclusion (L-u): {m['excluded']}"
+        elif mid in delivered:
+            why[mid] = "delivered in the previous 24 h"
+        elif m["channel_id"] in optout:
+            why[mid] = "channel opted out"
+        elif m.get("duration_s") is None or m["duration_s"] > SEG_MAX_S:
+            why[mid] = f"{m.get('duration_s')} s: over the {SEG_MAX_S} s per source video (L-u) or unmeasured"
+        elif "time_sensitive" in m.get("risk", []) and (E.age_hours(m["published_at"], ctx.now) or 1e9) > TIME_SENSITIVE_H:
+            why[mid] = f"time-sensitive words from a source older than {TIME_SENSITIVE_H} h (L-v 3)"
+        elif (m.get("speaker") or {}).get("turn_change_inside") is True:
+            why[mid] = "a speaker change inside (L-v 1)"
+        else:
+            out.append(m)
+    return out, why
+
+
+def runtime(segs, vo_s):
+    return round(sum(m["duration_s"] for m in segs) + vo_s + FIXED_S, 2)
+
+
+def content_range():
+    """Seconds the segments may fill so that some VO length inside VO_S lands the runtime in 60-70 s."""
+    return RUNTIME_S[0] - FIXED_S - VO_S[1], RUNTIME_S[1] - FIXED_S - VO_S[0]
+
+
+def candidate_sets(ms, k=TOP_SETS):
+    """Deterministic: hooks = moments eligible as a hook (by hook_first_2s, then rank); for each hook, the best clip
+    combinations of 2-3 moments from other channels (one segment per channel), inside content_range(); scored by the
+    moments' rank scores + topic diversity, at most PRICE_PREDICTIONS_MAX price predictions. Distinct sets, best first."""
+    lo, hi = content_range()
+    hooks = sorted([m for m in ms if (m.get("eligibility") or {}).get("hook", {}).get("ok")],
+                   key=lambda m: (-m["scores"]["hook_first_2s"], -m["rank_score"], m["moment_id"]))[:MAX_HOOKS]
+    clips = sorted([m for m in ms if (m.get("eligibility") or {}).get("clip", {}).get("ok")],
+                   key=lambda m: (-m["rank_score"], m["moment_id"]))[:24]
+    sets = []
+    for h in hooks:
+        pool = [c for c in clips if channel_of(c) != channel_of(h)]
+        for n in N_CLIPS:
+            for combo in itertools.combinations(pool, n):
+                chans = {channel_of(h)} | {channel_of(c) for c in combo}
+                if len(chans) != n + 1:
+                    continue
+                segs = [h, *combo]
+                dur = sum(m["duration_s"] for m in segs)
+                if not lo <= dur <= hi:
+                    continue
+                if sum("price_prediction" in m["risk"] for m in segs) > PRICE_PREDICTIONS_MAX:
+                    continue
+                topics = {t for m in segs for t in m["topics"]}
+                score = sum(m["rank_score"] for m in segs) + 1.5 * len(topics) + 2 * h["scores"]["hook_first_2s"]
+                sets.append((score, [m["moment_id"] for m in segs], segs))
+    sets.sort(key=lambda x: (-x[0], x[1]))
+    out, seen = [], set()
+    for score, ids, segs in sets:
+        key = frozenset(ids)
+        if key in seen or any(len(key & frozenset(o["ids"])) >= len(ids) - 1 for o in out):
+            continue                                   # distinct: no two offered sets differ by one moment only
+        seen.add(key)
+        out.append({"ids": ids, "segments": segs, "score": round(score, 2),
+                    "content_s": round(sum(m["duration_s"] for m in segs), 2)})
+        if len(out) >= k:
+            break
+    return out
+
+
+WRITE_PROMPT = """You are the editor and voice of PBX MAX, a 60-second Bitcoin video made of other channels' own words.
+Below are candidate SETS of clips. Each clip is a verbatim quote, with the channel that said it. The channels were NOT
+in one conversation (unless two clips share a video), and nobody here is answering anyone else.
+
+{note}
+{sets}
+
+Pick ONE set and write:
+- "set": its number; "order": its clip ids in play order, the hook first (the hook is the clip marked HOOK)
+- "type": "story" if every clip states the same development, else "moments"
+- "angle": one sentence: the point these clips make together (for the editor; it is checked like the VO)
+- "intro": the voice-over before the hook, at most {intro_words} words. The hook plays, then the first clip right
+  after it (no voice-over between them). "bridges": one voice-over line after each clip except the last (so a set of
+  a hook and 3 clips has 2 bridges; a hook and 2 clips has 1), each at most {bridge_words} words; a bridge names the
+  channel of the NEXT clip ("Next, Coin Bureau on ..."). The voice-over may make a point, but ONLY one the clips
+  themselves state.
+- "title": ONE title, at most 70 characters; "caption": ONE caption, at most 220 characters.
+Every line (intro, each bridge, title, caption) gives "cites": the ids of the clips it relies on.
+RULES (a line that breaks one is rejected):
+- every number, name, claim and time word ("today", "just") must be said in a cited clip, as the clip says it
+- attribute a view only to the channel that said it; never say or imply that channels agree, answer, rebut or react to
+  each other; no "both", "meanwhile ... fires back", "but X disagrees"
+- never stronger than the clip ("could" stays "could"); no "destroys", "slams", "exposes", "admits", "confirms",
+  "caught" unless the clip uses that word; no advice to the viewer to buy, sell or use leverage
+- no quotes except the clip's exact words; no names of people who are not speaking in or named by a clip
+Return ONLY this JSON object: {{"set": 1, "order": ["id", ...], "type": "moments", "angle": "...",
+"intro": {{"text": "...", "cites": ["id"]}}, "bridges": [{{"text": "...", "cites": ["id"]}}],
+"title": {{"text": "...", "cites": ["id"]}}, "caption": {{"text": "...", "cites": ["id"]}}}}"""
+
+
+def _sets_block(sets, ctx):
+    from story_semantics import quote_data
+    out = []
+    for i, s in enumerate(sets, 1):
+        out.append(f"SET {i} ({s['content_s']:.1f} s of clips):")
+        for j, m in enumerate(s["segments"]):
+            reg = ctx.channel(m["channel_id"]) or {}
+            out.append(f'  {"HOOK" if j == 0 else "clip"} id={m["moment_id"]} | {reg.get("display_name") or m["channel_name"]}'
+                       f' | {m["duration_s"]:.1f} s | topics {", ".join(TB.label(t) for t in m["topics"])} | '
+                       f'"{quote_data(m["text"], 700)}"')
+    return "\n".join(out)
+
+
+def budgets(content_s):
+    """Word budgets so the VO lands the runtime: VO seconds = target - FIXED_S - content, split intro / bridges."""
+    target = (RUNTIME_S[0] + RUNTIME_S[1]) / 2
+    vo_s = max(VO_S[0], min(VO_S[1], target - FIXED_S - content_s))
+    words = int(vo_s * WPS)
+    return max(6, int(words * 0.4)), max(5, int(words * 0.3)), vo_s
+
+
+def check_written(obj, sets):
+    """The writer's reply contract (strict; never repaired) -> (set, order, fields)."""
+    keys = {"set", "order", "type", "angle", "intro", "bridges", "title", "caption"}
+    if not isinstance(obj, dict) or set(obj) != keys:
+        raise ValueError(f"keys must be exactly {sorted(keys)}")
+    if type(obj["set"]) is not int or not 1 <= obj["set"] <= len(sets):
+        raise ValueError("'set' must be one of the offered set numbers")
+    s = sets[obj["set"] - 1]
+    if not isinstance(obj["order"], list) or sorted(obj["order"]) != sorted(s["ids"]) or obj["order"][0] != s["ids"][0]:
+        raise ValueError("'order' must be the set's ids, each once, the hook first")
+    if obj["type"] not in ("story", "moments") or not isinstance(obj["angle"], str) or not obj["angle"].strip():
+        raise ValueError("'type' must be story or moments; 'angle' a sentence")
+    lines = [("intro", obj["intro"]), ("title", obj["title"]), ("caption", obj["caption"])]
+    if not isinstance(obj["bridges"], list) or len(obj["bridges"]) != len(s["ids"]) - 2:
+        raise ValueError(f"'bridges' must hold {len(s['ids']) - 2} lines (one after each clip but the last; none "
+                         "between the hook and the first clip)")
+    lines += [(f"bridge_{i + 1}", b) for i, b in enumerate(obj["bridges"])]
+    for slot, ln in lines:
+        if not isinstance(ln, dict) or set(ln) != {"text", "cites"} or not isinstance(ln["text"], str) or \
+                not ln["text"].strip() or not isinstance(ln["cites"], list) or \
+                any(c not in s["ids"] for c in ln["cites"]):
+            raise ValueError(f"{slot}: needs text and cites from the set's ids")
+    if len(obj["title"]["text"]) > 70 or len(obj["caption"]["text"]) > 220:
+        raise ValueError("title <= 70 characters, caption <= 220")
+    return s, obj["order"], obj
+
+
+def signoff(segs, ctx):
+    """L-a: the spoken sign-off names exactly the credit set, hook first (code, never the model)."""
+    names = [(ctx.channel(m["channel_id"]) or {}).get("display_name") or m["channel_name"] for m in segs]
+    names = list(dict.fromkeys(names))
+    who = names[0] if len(names) == 1 else ", ".join(names[:-1]) + f", and {names[-1]}"
+    return f"Clips today from {who}. Go follow them for more. Links are below."
+
+
+def plain_vo(segs, ctx):
+    """L-w 2: the plain factual fallback VO ("Next, <show> on <topic>."), its topic the one every segment names by
+    rule (Bitcoin), so it claims nothing beyond who speaks."""
+    name = lambda m: (ctx.channel(m["channel_id"]) or {}).get("display_name") or m["channel_name"]
+    first = segs[0]
+    intro = {"text": f"Here's {name(first)} on Bitcoin.", "cites": [first["moment_id"]]}
+    bridges = [{"text": f"Next, {name(m)} on Bitcoin.", "cites": [m["moment_id"]]} for m in segs[2:]]
+    chans = list(dict.fromkeys(name(m) for m in segs))
+    title = {"text": (f"Bitcoin: {', '.join(chans[:-1])} and {chans[-1]}")[:70], "cites": [m["moment_id"] for m in segs]}
+    caption = {"text": f"Clips from {', '.join(chans)}. Links to every source below.",
+               "cites": [m["moment_id"] for m in segs]}
+    return intro, bridges, title, caption
+
+
+def assemble(order, by_id, fields, ctx, vo_kind):
+    segs = [by_id[i] for i in order]
+    reg = lambda m: (ctx.channel(m["channel_id"]) or {}).get("display_name") or m["channel_name"]
+    lines = [dict(fields["intro"], slot="intro")] + \
+        [dict(b, slot=f"bridge_{i + 1}") for i, b in enumerate(fields["bridges"])] + \
+        [dict(fields["title"], slot="title"), dict(fields["caption"], slot="caption")]
+    vo_words = sum(len(x["text"].split()) for x in lines if x["slot"].startswith(("intro", "bridge")))
+    pk = {"schema": "pp.package/1", "type": fields.get("type", "moments"), "angle": fields.get("angle", ""),
+          "vo_kind": vo_kind,
+          "segments": [{"label": "hook" if i == 0 else f"clip_{i:02d}", "moment_id": m["moment_id"],
+                        "video_id": m["video_id"], "channel_id": m["channel_id"], "channel": reg(m),
+                        "k0": m["sentences"][0], "k1": m["sentences"][1], "words": m["words"],
+                        "start": m["start"], "end": m["end"], "duration_s": m["duration_s"], "text": m["text"],
+                        "published_at": m["published_at"], "transcript_sha256": m["transcript_sha256"],
+                        "url_30s_before": f"https://www.youtube.com/watch?v={m['video_id']}&t={max(0, int(m['start']) - 30)}s"}
+                       for i, m in enumerate(segs)],
+          "vo": {"intro": fields["intro"]["text"], "bridges": [b["text"] for b in fields["bridges"]],
+                 "bridges_after_clip": list(range(1, len(fields["bridges"]) + 1)),     # the renderer's after_clip
+                 "signoff": signoff(segs, ctx)},
+          "title": fields["title"]["text"], "caption": fields["caption"]["text"],
+          "hook_first_words": " ".join(segs[0]["text"].split()[:8]),
+          "lines": lines}
+    vo_s = vo_words / WPS + len(pk["vo"]["signoff"].split()) / WPS - SIGNOFF_WORDS / WPS
+    pk["runtime_s_estimate"] = runtime(segs, vo_s)
+    pk["runtime_note"] = (f"segments {sum(m['duration_s'] for m in segs):.2f} s (word timing) + VO {vo_words} words at "
+                          f"{WPS} w/s (assumed) + fixed {FIXED_S} s; the render measures the final")
+    return pk
+
+
+def gates(router, pk, by_id, sources, writer_vendor, a_by_moment=None):
+    segs_v = {s["moment_id"]: {"speaker": s["channel"], "names": [s["channel"]], "video_id": s["video_id"],
+                               "text": s["text"]} for s in pk["segments"]}
+    lines = [{"slot": x["slot"], "text": x["text"], "cites": x["cites"]} for x in pk["lines"]]
+    fid = VF.check(router, segs_v, lines, writer_vendor)
+    a_by = None
+    if a_by_moment is not None:
+        a_by = {s["label"]: dict(a_by_moment[s["moment_id"]], label=s["label"]) for s in pk["segments"]}
+    ctx_ = CI.check_contexts(router, pk, CI.contexts_from_sources(pk, sources), writer_vendor, a_by=a_by)
+    rt_ok = RUNTIME_S[0] <= pk["runtime_s_estimate"] <= RUNTIME_S[1]
+    return {"fidelity": fid, "context": ctx_, "runtime_ok": rt_ok,
+            "ok": fid["ok"] and ctx_["ok"] and rt_ok}
