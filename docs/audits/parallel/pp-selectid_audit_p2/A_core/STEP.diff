+def write(router, sets, ctx, extra="", seed=7):
+    from select_by_id import UNTRUSTED
+    content = min(s["content_s"] for s in sets)
+    iw, bw, _ = budgets(content)
+    prompt = WRITE_PROMPT.format(note=UNTRUSTED.replace("<sentences>", "the quotes"), sets=_sets_block(sets, ctx),
+                                 intro_words=iw, bridge_words=bw)
+    if extra:
+        prompt += "\n\nYour previous script was rejected: " + extra[:1200] + "\nWrite it again, fixing exactly that."
+    r = router.call("angle_write", prompt, 3000, seed)
+    return r, check_written(json.loads(r.text.strip()), sets)
