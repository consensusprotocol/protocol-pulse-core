+def prescreen(router, ms, sources, ctx, n=PRESCREEN_N, batch=PRESCREEN_BATCH, writer_vendor="openai"):
+    """Step A (context only, package-independent by law L-s) on the best n usable moments, best first with distinct
+    channels first: {moment_id: A item}, {moment_id: [failing rules]}. The verdict is reused in the final decision.
+    writer_vendor: the vendor that will WRITE, so step A never runs on it."""
+    seen, order = set(), []
+    for m in sorted(ms, key=lambda m: (-m["rank_score"], m["moment_id"])):
+        if m["channel_id"] not in seen:
+            order.append(m)
+            seen.add(m["channel_id"])
+    order += [m for m in sorted(ms, key=lambda m: (-m["rank_score"], m["moment_id"])) if m not in order]
+    order = order[:n]
+    a_by, fails, vendors = {}, {}, set()
+    for i in range(0, len(order), batch):
+        chunk = order[i:i + batch]
+        contexts = {}
+        for m in chunk:
+            text, win = CI._window_text(sources[m["video_id"]], m["sentences"][0], m["sentences"][1])
+            contexts[m["moment_id"]] = {"text": text, "title": sources[m["video_id"]].title or "",
+                                        "channel": (ctx.channel(m["channel_id"]) or {}).get("display_name")
+                                        or m["channel_name"], "window": win,
+                                        "published": str(m.get("published_at") or "")[:16],
+                                        "show_date": ctx.now.strftime("%Y-%m-%d")}
+        try:
+            got, backend = CI.step_a(router, contexts, writer_vendor, seed=7 + i)
+            vendors.add(router.backends[backend].vendor if backend in router.backends else backend)
+        except Exception as e:                           # unreadable: these moments are not cleared (law L-m)
+            for m in chunk:
+                fails[m["moment_id"]] = [f"STEP_A_UNAVAILABLE: {type(e).__name__}"]
+            continue
+        for mid, a in got.items():
+            a_by[mid] = a
+            fails[mid] = CI.a_failures(a)
+    return a_by, fails, vendors
+
