+# ── angle first (orchestrator review 03:40: "select by angle, not by score") ──
+
+SHORT_CLIP_S = 8.0                 # a clip under ~8 s is a penalty unless it is the angle's punchline (the last clip)
+MAX_ANGLES = 5
+REWRITES = 3                       # a fidelity reject: up to 3 rewrites with the exact rejected claims, then plain VO
+COHERENCE_MIN = 4                  # the blind coherence verdict: every rating >= 4 and a through-line, else next angle
+VO_DEPENDENT = ("NOT_ENTAILED", "POLARITY", "STRONGER", "FALSE_RELATION")   # context failures the VO's framing causes
+VO_FIX = {"NOT_ENTAILED": "the viewer would take this clip to assert more than its speaker said in context: frame it as "
+                          "exactly what the speaker says",
+          "POLARITY": "the framing flips what the speaker meant: frame it as the speaker's own view",
+          "STRONGER": "the framing makes the speaker sound more certain than they were: keep their hedges ('I think', "
+                      "'could')",
+          "FALSE_RELATION": "the voice-over makes these speakers look like they respond to or agree WITH each other: "
+                            "credit each view to its own speaker, separately"}
+PRESENT = re.compile(r"\b(is|are|now|today|currently|right now|trading|sitting|this morning|tonight|at the moment|"
+                     r"just)\b", re.I)
