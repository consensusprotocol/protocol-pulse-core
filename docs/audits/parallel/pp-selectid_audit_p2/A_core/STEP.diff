+#!/usr/bin/env python3
+"""pipeline/package_pin.py — a pp.package/1 as the existing PINNED entry point's decision (pipeline/pinned.py, schema
+protocol_pulse.pinned_story.v1), so the SAME factory downstream (validate -> cut -> sentence law -> voice -> render ->
+gates -> release authorisation) renders a moments-first package.
+
+- Every segment carries `approved_text` = the moment's exact words (its source sentences, verbatim). The pin is
+  `machine_cuts`, so the sentence law locates the words BY TEXT in the acquired transcript, never by offsets.
+- Times are YouTube coordinates (the store record's own seconds in the full video).
+- `approved_by` names the machine and REVIEW ONLY. No human approved this decision (law L-q: the first delivery is
+  REVIEW ONLY).
+- The package's VO (intro, bridges), title, caption and the gate verdicts travel in `moments_package`. pinned.py at
+  c1451047 ignores the block, so its VO falls back to none; REQUESTS R7 makes pinned.build_edl use it.
+- Writes nothing itself: to_pin() returns the dict; write_pin() writes it beside the package.
+"""
+import hashlib
+import json
+import os
+from datetime import datetime, timezone
+
+SCHEMA = "protocol_pulse.pinned_story.v1"
+
+
+def to_pin(pk, run_name):
+    segs = []
+    for i, s in enumerate(pk["segments"]):
+        segs.append({"role": "hook" if i == 0 else "clip", "video_id": s["video_id"], "channel": s["channel"],
+                     "start": round(float(s["start"]), 3), "end": round(float(s["end"]), 3),
+                     "approved_text": s["text"], "time_coords": "youtube", "source": {"kind": "youtube"}})
+    body = json.dumps(pk, sort_keys=True, default=str).encode()
+    return {"schema": SCHEMA, "story_id": f"moments-{run_name}-{hashlib.sha256(body).hexdigest()[:8]}",
+            "label": "bitcoin", "headline": pk["title"],
+            "approved_by": "machine:pp-selectid moments-first (REVIEW ONLY, not approved by a human)",
+            "approved_at": datetime.now(timezone.utc).isoformat(timespec="seconds"),
+            "approval_ref": f"docs/audits/parallel/pp-selectid_STATE.md (top package, {run_name})",
+            "machine_cuts": True, "segments": segs,
+            "moments_package": {"schema": pk["schema"], "package_sha256": hashlib.sha256(body).hexdigest(),
+                                "type": pk["type"],
+                                "edl_vo": {"intro": pk["vo"]["intro"],
+                                           "bridges": [{"text": t, "after_clip": a} for t, a in
+                                                       zip(pk["vo"]["bridges"], pk["vo"]["bridges_after_clip"])]},
+                                "signoff_expected": pk["vo"]["signoff"],
+                                "title": pk["title"], "caption": pk["caption"],
+                                "hook_first_words": pk["hook_first_words"],
+                                "vo_jobs": {"intro": "context", **{f"bridge_{i + 1}": "connection"
+                                                                   for i in range(len(pk["vo"]["bridges"]))}},
+                                "checks": {"vo_fidelity_ok": True, "context_integrity_ok": True,
+                                           "models": pk.get("models")},
+                                "runtime_s_estimate": pk["runtime_s_estimate"],
+                                "sources_30s_before": [s["url_30s_before"] for s in pk["segments"]]}}
+
+
+def write_pin(pk, run_name, out_dir):
+    pin = to_pin(pk, run_name)
+    os.makedirs(out_dir, exist_ok=True)
+    path = os.path.join(out_dir, "MOMENTS_PIN.json")
+    with open(path, "w") as f:
+        json.dump(pin, f, indent=1)
+    return path, pin
