+#!/usr/bin/env python3
+"""pipeline/vo_fidelity.py — VO FIDELITY (law L-o 11, '01:55'; law L-t, '02:30'): the PBX MAX VO, the title and the
+caption never put words in a speaker's mouth. Two layers, BOTH must pass ("vo check needs to be real 100%"):
+
+(a) DETERMINISTIC (this module, no model): every line names the segments it relies on (cites = moment ids), and
+    - NEEDS_SOURCE: a line with a fact (number, name, quote, attribution, time word) cites at least one segment;
+    - NUMBER: every number (canon value and unit, law L-k) is in a cited segment's sentences; when the line attributes
+      it to a speaker, in THAT speaker's sentences;
+    - NAME: every proper name is in a cited segment's sentences, or is production metadata (a credited channel, the
+      show); no name of a person who does not appear (L-t);
+    - QUOTE: quoted words are a verbatim run of a cited segment (canonical form);
+    - ATTRIBUTION: "<X> says / argues / warns ..." binds X to a cited segment whose speaker is X;
+    - RELATION: words that make speakers answer, agree or rebut each other only when every cited segment is from the
+      same source video (one conversation);
+    - FRAMING: destroys / slams / exposes / admits / confirms / caught only when the source itself uses the word (L-t);
+    - IMPERATIVE: no second-person financial imperative (buy / sell / leverage / all in) (L-t);
+    - TIME: a time word (today, yesterday, this week, just, now) only when a cited segment says it (L-v 3).
+(b) BLIND VERDICT (role "fidelity_verdict" through pipeline/providers.py, never the writer's vendor): given ONLY the
+    segments' sentences and the lines, every claim the text makes, implied ones included (agreement, sequence,
+    certainty, cause), each yes / no / uncertain with the supporting segment and its words COPIED EXACTLY. The decision
+    is code: every claim "yes" AND its words a verbatim run of that segment (an unverifiable support is a "no");
+    "no" or "uncertain" anywhere fails (law L-m).
+"""
+import json
+import re
+
+import canon
+
+METADATA = ("PBX MAX", "Protocol Pulse", "Pulse Check", "Bitcoin", "BTC")
+ATTRIB_VERBS = ("says", "said", "argues", "argued", "thinks", "believes", "warns", "warned", "predicts", "predicted",
+                "claims", "claimed", "notes", "noted", "explains", "explained", "expects", "sees", "points out",
+                "pointed out", "tells", "told", "adds", "added", "calls", "called", "reckons", "insists", "suggests")
+RELATION = re.compile(r"\b(agree[sd]?|agreeing|disagree[sd]?|respond(s|ed|ing)?|repl(y|ies|ied)|answer(s|ed|ing)?|"
+                      r"rebut(s|ted)?|push(es|ed)? back|counter(s|ed)?|fire[sd]? back|echo(es|ed)?|contradict(s|ed)?|"
+                      r"back(s|ed)? (him|her|them|that) up|sides? with|takes? issue|in response|on the other side|"
+                      r"weighs? in on|shoots? down|both (say|agree|think|warn))\b", re.I)
+FRAMING = {"destroy": r"destroy\w*", "slam": r"slam\w*", "expose": r"expos\w*", "admit": r"admi(t|ts|tted|tting)\b",
+           "confirm": r"confirm\w*", "caught": r"caught"}
+IMPERATIVE = re.compile(r"(\byou (should|need to|must|have to|ought to|'?ve got to)\s+(buy|sell|short|long|load up|"
+                        r"ape|go all[- ]in|get in|stack|leverage|lever up|bet)\b)|((^|[.!?:]\s*)(buy|sell|short|load up|"
+                        r"ape in|go all[- ]in|get in now|don't miss|stack sats|lever up)\b)",
+                        re.I)
+TIME_WORDS = ("today", "tonight", "yesterday", "this morning", "this week", "this weekend", "right now", "breaking",
+              "minutes ago", "hours ago", "just announced", "just hit", "just broke", "just dropped", "just crossed",
+              "just fell", "just jumped", "just surged", "just plunged")   # recency claims (a bare 'now' / 'just' is
+                                                                          # connective VO, not a time claim)
+_NUM = re.compile(r"^-?\d+(\.\d+)?$")
+HISTORY = re.compile(r"\b(19|20)\d{2}\b|\b(since|back in|last cycle|previous cycle|history|historic(al)?|all[- ]time|"
+                     r"from the \w+ (low|high|bottom|top)|years? ago|decade|in the past|once)\b", re.I)
+PRICE_SLOTS = ("intro", "title", "caption")      # the lines that read as the headline (law L-t, orchestrator 03:40)
+
+
+def price_levels(text):
+    """Bitcoin price-like numbers a line states: canonical values >= 1000 (with or without 'dollars'), or any value
+    followed by 'dollars' (law L-v 3: a level or a move dates fast)."""
+    t = ctoks(text)
+    out = []
+    for i, w in enumerate(t):
+        if _NUM.match(w):
+            v = float(w)
+            if v >= 1000 or (i + 1 < len(t) and t[i + 1] == "dollars"):
+                out.append(v)
+    return out
+
+
+def price_now(text, current_levels, tolerance=0.05):
+    """PRICE_NOW (orchestrator 03:40; laws L-v 3 / L-t): a headline line stating a price level or move must either
+    read as history (a year, 'since', 'from the 2022 low', ...) or match a level this universe states as current
+    (within tolerance). -> [violating values]."""
+    if HISTORY.search(text or ""):
+        return []
+    cur = [float(c) for c in current_levels or ()]
+    return [v for v in price_levels(text) if not any(abs(v - c) <= tolerance * c for c in cur if c > 0)]
+_QUOTE = re.compile(r"[\"“”]([^\"“”]{3,}?)[\"“”]")
+_CAPWORD = re.compile(r"\b[A-Z][A-Za-z0-9'’.&-]*(?:\s+[A-Z][A-Za-z0-9'’.&-]*)*")
+COMMON_CAPS = frozenset("I The This That These Those It And But So We You They He She Here There Now Today Next First "
+                        "Then Also Plus Meanwhile Still Yet Why What How When Where Who Which Our Your Their Its "
+                        "Let Let's Clips Go Links Follow Watch Stay A An In On At For From With As If Not No Yes "
+                        "One Two Three Four Five Six Seven Eight Nine Ten Here's That's It's".split())
+
+
+def ctoks(text):
+    return canon.canon_tokens(text or "")
+
+
+def _run_in(sub, toks):
+    """sub (canonical tokens) occurs as a contiguous run in toks."""
+    n = len(sub)
+    return n > 0 and any(toks[i:i + n] == sub for i in range(len(toks) - n + 1))
+
+
+def numbers_of(text):
+    """[(value, unit or None)] in canonical form: '$73,000' -> ('73000', 'dollars'); '16%' -> ('16', 'percent')."""
+    t = ctoks(text)
+    out = []
+    for i, w in enumerate(t):
+        if _NUM.match(w):
+            unit = t[i + 1] if i + 1 < len(t) and t[i + 1] in ("dollars", "percent") else None
+            out.append((w, unit))
+    return out
+
+
+def _has_number(src_toks, value, unit):
+    for i, w in enumerate(src_toks):
+        if w == value and (unit is None or (i + 1 < len(src_toks) and src_toks[i + 1] == unit)):
+            return True
+    return False
+
+
+def _title_case(text):
+    """A headline written in Title Case: >= 3 longer words, production names left out, > 70 % of them capitalised."""
+    meta = {w.lower() for m in METADATA for w in m.split()}
+    ws = [w for w in re.findall(r"[A-Za-z][A-Za-z'’]+", text or "") if len(w) > 3 and w.lower().rstrip("'’s") not in meta
+          and re.sub(r"['’]s$", "", w).lower() not in meta]
+    return len(ws) >= 3 and sum(w[0].isupper() for w in ws) / len(ws) > 0.7
+
+
+def names_of(text, allowed=()):
+    """Proper names in a line: capitalised word runs that are not common sentence words or production metadata. A
+    capital that only starts a sentence, and a Title Case line, are no evidence of a name (measured false rejects,
+    03:55: 'Past', 'Beyond', 'Historical', 'Bullish Claims Don't Erase Risk'); names there are caught by ATTRIBUTION
+    and by the blind verdict, which lists every claim about a person."""
+    if _title_case(text):
+        return []
+    allowed_c = [ctoks(a) for a in tuple(allowed) + METADATA]
+    out = []
+    starts = {0} | {m.end() for m in re.finditer(r"[.!?:;]\s+|[\"“(]\s*", text or "")}
+    for m in _CAPWORD.finditer(text or ""):
+        if m.start() in starts and len(m.group(0).split()) == 1:
+            continue
+        words = [w for w in m.group(0).split() if w.strip(".,'’")]
+        while words and words[0].strip(".,'’") in COMMON_CAPS:
+            words = words[1:]
+        if not words:
+            continue
+        name = re.sub(r"['’]s$", "", " ".join(words).strip(".,'’"))     # "Bitcoin's" is the name "Bitcoin"
+        nt = ctoks(name)
+        if not nt or all(_NUM.match(x) for x in nt):
+            continue
+        if any(_run_in(nt, a) or _run_in(a, nt) for a in allowed_c if a):
+            continue
+        out.append(name)
+    return out
+
+
+def _attributions(text):
+    """[(subject words before the verb, verb)] for '<Subject> <verb>' patterns."""
+    out = []
+    for v in ATTRIB_VERBS:
+        for m in re.finditer(r"([A-Z][\w'’.&-]*(?:\s+[A-Z][\w'’.&-]*){0,4})\s+" + re.escape(v) + r"\b", text or ""):
+            out.append((m.group(1), v))
+        for m in re.finditer(r"\baccording to\s+([A-Z][\w'’.&-]*(?:\s+[A-Z][\w'’.&-]*){0,4})", text or ""):
+            out.append((m.group(1), "according to"))
+    return out
+
+
+def manifest_terms(segments, manifest=None):
+    """Production metadata a line may state without a citation (never a claim about what anyone said): the credited
+    channels and verified speaker names, the show, the date (month, weekday, day, year) and the package's own counts
+    ('two voices', 'three channels')."""
+    from datetime import date
+    names = {n for s in segments.values() for n in [s["speaker"]] + list(s.get("names") or [])}
+    m = manifest or {}
+    names |= set(m.get("channels") or []) | ({m["show"]} if m.get("show") else set())
+    nums = {str(len(segments)), str(len({s["video_id"] for s in segments.values()})),
+            str(len(set(m.get("channels") or []) or {s["speaker"] for s in segments.values()}))}
+    if m.get("date"):
+        try:
+            d = date.fromisoformat(m["date"])
+            names |= {d.strftime("%B"), d.strftime("%A"), d.strftime("%b")}
+            nums |= {str(d.day), str(d.year)}
+        except ValueError:
+            pass
+    return sorted(names), nums
+
+
+def check_deterministic(segments, lines, manifest=None, current_levels=None):
+    """segments: {moment_id: {"speaker": str, "names": [allowed attribution names], "video_id": str, "text": str}};
+    lines: [{"slot": str, "text": str, "cites": [moment_id, ...]}] (VO lines, the title, the caption); manifest:
+    {"channels", "date", "show"} (production metadata, allowed without citation).
+    -> {"ok": bool, "violations": [{"slot", "rule", "detail"}]}."""
+    v = []
+    meta, meta_nums = manifest_terms(segments, manifest)
+    seg_toks = {mid: ctoks(s["text"]) for mid, s in segments.items()}
+    for ln in lines:
+        slot, text, cites = ln["slot"], ln.get("text") or "", list(ln.get("cites") or [])
+        V = lambda rule, detail: v.append({"slot": slot, "rule": rule, "detail": detail})
+        unknown = [c for c in cites if c not in segments]
+        if unknown:
+            V("CITE_UNKNOWN", f"cites {unknown} are not segments of this package")
+        cited = [c for c in cites if c in segments]
+        pool = [t for c in cited for t in seg_toks[c]]
+        nums = [(val, unit) for val, unit in numbers_of(text) if not (unit is None and val in meta_nums)
+                and not (unit is None and _NUM.match(val) and float(val) <= 10 and not re.search(rf"\b{re.escape(val)}\b", text))]
+        names = names_of(text, meta)
+        quotes = [q for q in _QUOTE.findall(text) if len(ctoks(q)) >= 2]
+        atts = _attributions(text)
+        times = [w for w in TIME_WORDS if re.search(r"\b" + re.escape(w) + r"\b", text, re.I)]
+        if (nums or names or quotes or atts or times) and not cited:
+            V("NEEDS_SOURCE", "a line with a number, name, quote, attribution or time word cites no segment")
+        att_pool = pool
+        for subj, verb in atts:
+            st = ctoks(subj)
+            owners = [c for c in cited if any(_run_in(ctoks(n), st) or _run_in(st, ctoks(n))
+                                              for n in [segments[c]["speaker"]] + list(segments[c].get("names") or []))]
+            if not owners:
+                V("ATTRIBUTION", f"'{subj} {verb}': no cited segment is spoken by {subj}")
+            else:
+                att_pool = [t for c in owners for t in seg_toks[c]]
+        for val, unit in nums:
+            if not _has_number(att_pool if atts else pool, val, unit):
+                V("NUMBER", f"{val}{' ' + unit if unit else ''} is not in the cited sentences" +
+                  (" of the attributed speaker" if atts else ""))
+        for n in names:
+            if not _run_in(ctoks(n), pool):
+                V("NAME", f"'{n}' is not said in the cited sentences (and is not a credited channel or the show)")
+        for q in quotes:
+            if not any(_run_in(ctoks(q), seg_toks[c]) for c in cited):
+                V("QUOTE", f"\"{q}\" is not a verbatim run of a cited segment")
+        if RELATION.search(text) and len({segments[c]["video_id"] for c in cited}) != 1:
+            V("RELATION", f"'{RELATION.search(text).group(0)}' relates speakers who were not in one conversation")
+        if RELATION.search(text) and len(cited) < 2:
+            V("RELATION", f"'{RELATION.search(text).group(0)}' implies an exchange the cited segments do not show")
+        for lemma, pat in FRAMING.items():
+            if re.search(r"\b" + pat, text, re.I) and not any(re.search(r"\b" + pat, segments[c]["text"], re.I)
+                                                              for c in cited):
+                V("FRAMING", f"'{lemma}' framing is not the source's own word (L-t)")
+        if IMPERATIVE.search(text):
+            V("IMPERATIVE", f"financial imperative or advice framing: '{IMPERATIVE.search(text).group(0).strip()}'")
+        for w in times:
+            if not any(_run_in(ctoks(w), seg_toks[c]) for c in cited):
+                V("TIME", f"'{w}' is not said in the cited sentences (L-v 3: time words need the source's own)")
+        if slot.split("_")[0] in PRICE_SLOTS and current_levels is not None:
+            stale = price_now(text, current_levels)
+            if stale:
+                V("PRICE_NOW", f"states the level(s) {stale} as if current, but this universe's current levels are "
+                               f"{sorted(set(current_levels))[:6]}; mark it as history or drop it (L-v 3 / L-t)")
+    return {"ok": not v, "violations": v}
+
+
+VERDICT_PROMPT = """You check a short video script for fidelity to its sources. You see ONLY the words each speaker said
+(the segments), the production facts (true by construction), and the script's lines (voice-over, title, caption).
+Nothing else is known about these people.
+
+SEGMENTS:
+{segments}
+
+PRODUCTION FACTS (segment label "manifest"):
+{manifest}
+
+SCRIPT LINES:
+{lines}
+
+List EVERY claim the script lines make or imply, including implied ones: that a speaker said, thinks, agrees, answers
+or disagrees; a number; a time ("today"); a cause; how certain something is. For each claim answer "supported":
+"yes" only if the words you cite state it with the same meaning, polarity and certainty, adding nothing; "no" if they
+do not; "uncertain" if you cannot tell. A claim may combine what SEVERAL segments say (a point drawn from two clips):
+then cite each segment with its own supporting words, and say "yes" only if those words together state the claim
+without any added inference. Copy every supporting run EXACTLY (a continuous run of that segment's words). A purely
+connective line ("Next, ...") makes no claim.
+Return ONLY this JSON object: {{"claims": [{{"line": "<slot>", "claim": "...", "supported": "yes" | "no" | "uncertain",
+"support": [{{"segment": "<label>", "words": "<exact words>"}}]}}]}}"""
+
+
+def manifest_text(segments, manifest=None):
+    """The production facts a line may state: the credited channels, the show, the date, that source links are given."""
+    m = manifest or {}
+    chans = list(dict.fromkeys(list(m.get("channels") or []) + [s["speaker"] for s in segments.values()]))
+    parts = [f"The video is about Bitcoin and contains clips from {', '.join(chans)}.", f"There are {len(segments)} clips.",
+             "Links to every source are below.", "The voice-over is PBX MAX on Protocol Pulse."]
+    if m.get("show"):
+        parts.append(f"The show is {m['show']}.")
+    if m.get("date"):
+        parts.append(f"The show date is {m['date']}.")
+    return " ".join(parts)
+
+
+def verdict_prompt(segments, lines, manifest=None):
+    from story_semantics import quote_data
+    seg = "\n".join(f'<segment label="{mid}" speaker="{quote_data(s["speaker"], 80)}">{quote_data(s["text"], 900)}'
+                    f"</segment>" for mid, s in segments.items())
+    lns = "\n".join(f'<line slot="{ln["slot"]}">{quote_data(ln.get("text") or "", 400)}</line>' for ln in lines)
+    return VERDICT_PROMPT.format(segments=seg, lines=lns, manifest=manifest_text(segments, manifest))
+
+
+def check_verdict(raw, segments, lines, manifest=None):
+    """The blind verdict's reply (strict; never repaired) -> {"ok", "claims", "violations"}. A "yes" must cite one or
+    more segments (or "manifest"), each with words that are a verbatim run of that segment: an unverifiable support is
+    a failure (law L-m)."""
+    obj = json.loads(raw.strip()) if isinstance(raw, str) else None
+    if not isinstance(obj, dict) or set(obj) != {"claims"} or not isinstance(obj["claims"], list):
+        raise ValueError("the verdict must be exactly {'claims': [...]}")
+    slots = {ln["slot"] for ln in lines}
+    texts = dict({mid: s["text"] for mid, s in segments.items()}, manifest=manifest_text(segments, manifest))
+    v = []
+    for c in obj["claims"]:
+        if not isinstance(c, dict) or set(c) != {"line", "claim", "supported", "support"}:
+            raise ValueError("each claim needs exactly line, claim, supported, support")
+        if c["line"] not in slots or c["supported"] not in ("yes", "no", "uncertain") or \
+                not isinstance(c["claim"], str) or not isinstance(c["support"], list):
+            raise ValueError(f"claim on line {c.get('line')!r}: unknown line, 'supported' value or support list")
+        if c["supported"] != "yes":
+            v.append({"slot": c["line"], "rule": "VERDICT_" + c["supported"].upper(), "detail": c["claim"][:200]})
+            continue
+        good = [x for x in c["support"] if isinstance(x, dict) and x.get("segment") in texts and
+                isinstance(x.get("words"), str) and len(ctoks(x["words"])) >= 2 and
+                _run_in(ctoks(x["words"]), ctoks(texts[x["segment"]]))]
+        if not c["support"] or len(good) != len(c["support"]):
+            v.append({"slot": c["line"], "rule": "VERDICT_UNVERIFIED",
+                      "detail": f"supporting words are not verbatim runs of the cited segments: {c['claim'][:150]}"})
+    return {"ok": not v, "claims": obj["claims"], "violations": v}
+
+
+def check(router, segments, lines, writer_vendor, seed=7, manifest=None, current_levels=None):
+    """Both layers. -> {"ok", "deterministic", "verdict", "violations", "backend"}; the verdict never runs on the
+    writer's vendor; a verdict that cannot be had or read is a failure (law L-m)."""
+    import providers as P
+    det = check_deterministic(segments, lines, manifest, current_levels)
+    out = {"deterministic": det, "verdict": None, "backend": None}
+    try:
+        r = router.call("fidelity_verdict", verdict_prompt(segments, lines, manifest), 2500, seed,
+                        avoid_vendor=writer_vendor)
+        out["backend"] = r.backend
+        out["verdict"] = check_verdict(r.text, segments, lines, manifest)
+    except (P.ProviderError, P.SpendLimit, ValueError) as e:
+        out["verdict"] = {"ok": False, "claims": [], "violations": [{"slot": "-", "rule": "VERDICT_UNAVAILABLE",
+                                                                      "detail": f"{type(e).__name__}: {str(e)[:200]}"}]}
+    out["violations"] = det["violations"] + out["verdict"]["violations"]
+    out["ok"] = det["ok"] and out["verdict"]["ok"]
+    return out
