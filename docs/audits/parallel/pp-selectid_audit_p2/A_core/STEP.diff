+def build(router, moments, sources, ctx, delivered=(), optout=frozenset(), log=print, want=1, max_angles=MAX_ANGLES,
+          truth_dir=None):
+    """Angle first (orchestrator 03:40). usable -> step-A prescreen -> ANGLES (role angle_write) -> per angle: line-up
+    (code) -> write -> integrity gates (hard) -> on a fidelity reject up to REWRITES rewrites with the exact rejected
+    claims -> COHERENCE (blind quality verdict, other vendor) -> law L-v 2 second recognition pass on the segments
+    (truth_dir set) -> a package. A context / truth failure drops that moment and rebuilds the angle's line-up; a
+    coherence failure moves to the next angle. The plain VO is the last resort, ranked below every written VO.
+    -> {"packages": [best first], "package": the best or None, "tried": [...], ...}."""
+    import transcript_truth as TT
+    ms, why = usable(moments, ctx, delivered, optout)
+    writer_vendor = _writer_vendor(router)
+    a_by, fails, a_vendors = prescreen(router, ms, sources, ctx, writer_vendor=writer_vendor)
+    cleared = {m["moment_id"]: m for m in ms if m["moment_id"] in a_by and not fails.get(m["moment_id"])}
+    levels = current_levels(sources.values(), ctx)
+    out = {"packages": [], "plain": [], "tried": [], "unusable": why, "usable": len(ms), "current_levels": levels,
+           "prescreen": {"screened": len(fails), "cleared": len(cleared),
+                         "failed": {mid: f for mid, f in fails.items() if f}}, "angles": []}
+    if len({m["channel_id"] for m in cleared.values()}) < 3:
+        out["why_none"] = f"{len(cleared)} moments cleared step A from fewer than 3 channels"
+        out["package"] = None
+        return out
+    from select_by_id import UNTRUSTED
+    from story_semantics import quote_data
+    clips = "\n".join(f'id={m["moment_id"]} | {(ctx.channel(m["channel_id"]) or {}).get("display_name") or m["channel_name"]}'
+                      f' | {m["duration_s"]:.1f} s | "{quote_data(m["text"], 600)}"'
+                      for m in sorted(cleared.values(), key=lambda m: (-m["rank_score"], m["moment_id"])))
+    try:
+        lo, hi = content_range()
+        r = router.call("angle_write", ANGLE_PROMPT.format(note=UNTRUSTED.replace("<sentences>", "the quotes"),
+                                                           clips=clips, k=max_angles, lo=lo, hi=hi), 3000, 7)
+        angles = check_angles(json.loads(r.text.strip()), cleared, max_angles)
+    except Exception as e:
+        out["why_none"] = f"no readable angles: {type(e).__name__}: {str(e)[:200]}"
+        out["package"] = None
+        return out
+    out["angles"] = [{"angle": a["angle"], "moments": a["moments"], "hook": a["hook"]} for a in angles]
+    dropped = set()
+    for ai, angle in enumerate(angles):
+        if len(out["packages"]) >= want:
+            break
+        for rebuild in range(3):                         # a context / truth failure drops a moment and rebuilds
+            segs = lineup_for(angle, cleared, frozenset(dropped))
+            rec = {"angle": ai + 1, "rebuild": rebuild + 1}
+            if segs is None:
+                rec["why"] = "no line-up: fewer than a hook + 2 clips from distinct channels in the runtime arithmetic"
+                out["tried"].append(rec)
+                break
+            order = [m["moment_id"] for m in segs]
+            extra, pk, g, wr = "", None, None, None
+            for attempt in range(1 + REWRITES):
+                try:
+                    wr, fields = write_v2(router, angle, segs, ctx, extra=extra, seed=7 + attempt + 10 * ai)
+                except Exception as e:
+                    rec.setdefault("writer_errors", []).append(f"{type(e).__name__}: {str(e)[:200]}")
+                    continue
+                pk = assemble(order, cleared, fields, ctx, "written" if attempt == 0 else f"rewritten x{attempt}")
+                g = integrity(router, pk, sources, wr.vendor, None if wr.vendor in a_vendors else a_by, levels,
+                              ctx.now)
+                rec.setdefault("attempts", []).append({"fid_ok": g["fid_ok"], "context_ok": g["context"]["ok"],
+                                                       "runtime": pk["runtime_s_estimate"],
+                                                       "violations": g["fidelity"]["violations"] + g["duplicates"] +
+                                                       g["context"]["violations"]})
+                framing = [v for v in g["context"]["violations"] if v["rule"] in VO_DEPENDENT]
+                intrinsic = [v for v in g["context"]["violations"] if v["rule"] not in VO_DEPENDENT]
+                if g["ok"] or intrinsic:
+                    break                                # done, or a clip's own context fails: drop it below
+                if g["fid_ok"] and not framing:
+                    break
+                bad = g["fidelity"]["violations"] + g["duplicates"] + [
+                    {"slot": v["segment"], "rule": v["rule"], "detail": VO_FIX.get(v["rule"], v["detail"])}
+                    for v in framing]
+                extra = ("Your previous script was REJECTED. Exactly these lines failed, with the reason; rewrite them "
+                         "so they make the same point ONLY with what the cited clips state:\n" +
+                         "\n".join(f"- {v['slot']}: {v['rule']}: {v['detail']}" for v in bad))
+            if g is None:
+                out["tried"].append(rec)
+                break
+            if not g["context"]["ok"]:
+                bad = {sg["moment_id"] for sg in pk["segments"]
+                       if any(sg["label"] in v["segment"].split("+") for v in g["context"]["violations"])}
+                dropped |= bad or {order[-1]}
+                rec["why"] = "context integrity (B / C): dropped " + ", ".join(sorted(bad or {order[-1]}))
+                out["tried"].append(rec)
+                continue
+            if not g["ok"]:                              # written VO failed after the rewrites: the plain VO, ranked last
+                intro, bridges, title, caption = plain_vo(segs, ctx)
+                pk3 = assemble(order, cleared, {"intro": intro, "bridges": bridges, "title": title, "caption": caption,
+                                                "type": "moments", "angle": angle["angle"] + " (plain VO, L-w 2)"},
+                               ctx, "plain")
+                g3 = integrity(router, pk3, sources, wr.vendor, None if wr.vendor in a_vendors else a_by, levels,
+                               ctx.now)
+                rec["plain"] = {"ok": g3["ok"], "violations": g3["fidelity"]["violations"] + g3["duplicates"]}
+                if g3["ok"]:
+                    pk3["checks"] = {"integrity": _checks(g3), "coherence": None, "vo": "PLAIN VO (fallback, ranked last)"}
+                    pk3["models"] = {"writer": "plain template", "fidelity_verdict": g3["fidelity"]["backend"],
+                                     "context": g3["context"].get("backends")}
+                    out["plain"].append(pk3)
+                out["tried"].append(rec)
+                break
+            ok_c, verdict = coherence(router, pk, wr.vendor)
+            rec["coherence"] = verdict
+            if not ok_c:
+                rec["why"] = "coherence below 4 or no through-line: next angle"
+                out["tried"].append(rec)
+                break
+            if truth_dir:
+                truth = []
+                for sg in pk["segments"]:
+                    if any(TT.critical_tokens(sg["text"])[k] for k in ("numbers", "negations")):
+                        try:
+                            truth.append(dict(TT.verify_segment(sg["video_id"], float(sg["start"]), float(sg["end"]),
+                                                                sg["text"], truth_dir), label=sg["label"],
+                                              moment_id=sg["moment_id"]))
+                        except Exception as e:
+                            truth.append({"label": sg["label"], "moment_id": sg["moment_id"],
+                                          "error": f"{type(e).__name__}: {str(e)[:160]}"})
+                rec["truth"] = truth
+                bad = {t["moment_id"] for t in truth if t.get("error") or not t.get("transcript_ok")
+                       or (t.get("speakers") or {}).get("turn_change_inside")}
+                if bad:
+                    dropped |= bad
+                    rec["why"] = "law L-v: the second pass disagrees or a speaker changes: dropped " + ", ".join(sorted(bad))
+                    out["tried"].append(rec)
+                    continue
+                pk["transcript_truth"] = truth
+            pk["checks"] = {"integrity": _checks(g), "coherence": verdict, "vo": pk["vo_kind"]}
+            pk["models"] = {"writer": wr.backend, "fidelity_verdict": g["fidelity"]["backend"],
+                            "context": g["context"].get("backends"), "coherence": verdict.get("backend")}
+            out["packages"].append(pk)
+            out["tried"].append(dict(rec, result="PACKAGE"))
+            dropped |= set(order)                        # alternatives use other moments
+            break
+    rank = lambda p: (-min(list(p["checks"]["coherence"]["clips"].values()) + [p["checks"]["coherence"]["vo_point"]]),
+                      -sum(p["checks"]["coherence"]["clips"].values()))
+    out["packages"].sort(key=rank)
+    out["package"] = (out["packages"] or out["plain"] or [None])[0]
+    return out
+
+
+def _checks(g):
+    return {"vo_fidelity": {"deterministic": g["fidelity"]["deterministic"], "verdict": g["fidelity"]["verdict"],
+                            "backend": g["fidelity"]["backend"]},
+            "duplicates": g["duplicates"],
+            "context_integrity": {k: v for k, v in g["context"].items() if k != "segments"},
+            "context_segments": g["context"]["segments"], "runtime_ok": g["runtime_ok"]}
+
+
+def _writer_vendor(router):
+    """The vendor of the first available writer in the chain (so step A avoids it); 'openai' if it cannot be told."""
+    try:
+        name = router.chain("angle_write")[0]
+        return router.backends[name].vendor
+    except Exception:
+        return "openai"
