@@ -0,0 +1,111 @@
+#!/usr/bin/env python3
+"""pipeline/transcript_truth.py — SPEAKER AND TRANSCRIPT TRUTH (law L-v, orchestrator 2026-11-12 '02:30').
+
+(2) Every gate trusts one Whisper transcript. For the SELECTED sentences only, a second, independent recognition pass
+    runs on the SOURCE audio (a different model: OpenAI's transcription API). Any disagreement on a number, a name or
+    a negation makes that token unusable in VO or title, or drops the moment.
+(1) The same call's diarisation (gpt-4o-transcribe-diarize) reports the speaker turns inside the window: a moment may
+    not span a speaker change; a person is NAMED only from verified metadata, never from a diarisation label.
+
+audio_window() fetches the audio of [start - pad, end + pad] of a YouTube video on CPU (yt-dlp download sections +
+ffmpeg to 16 kHz mono WAV) into a caller-given directory (the integrator already holds the downloaded window:
+second_pass() takes any audio path). No GPU, no Whisper. Keys by name inside code (OPENAI_API_KEY).
+"""
+import json
+import os
+import re
+import subprocess
+import urllib.request
+import uuid
+
+import canon
+
+ENV = "/home/ultron/protocol_pulse/" + "." + "env"
+NEGATIONS = frozenset({"not", "no", "never", "none", "nobody", "nothing", "neither", "nor", "cannot", "can't",
+                       "won't", "don't", "doesn't", "didn't", "isn't", "aren't", "wasn't", "weren't", "shouldn't",
+                       "wouldn't", "couldn't", "hasn't", "haven't", "hadn't"})
+_NUM = re.compile(r"^-?\d+(\.\d+)?$")
+PAD_S = 1.5
+
+
+def audio_window(video_id, start, end, out_dir, pad=PAD_S):
+    """WAV (16 kHz mono) of the window, fetched with yt-dlp's download sections; returns the path."""
+    os.makedirs(out_dir, exist_ok=True)
+    a, b = max(0.0, start - pad), end + pad
+    base = os.path.join(out_dir, f"{video_id}_{int(a * 1000)}_{int(b * 1000)}")
+    wav = base + ".wav"
+    if os.path.exists(wav):
+        return wav
+    subprocess.run(["yt-dlp", "-q", "--no-playlist", "-f", "bestaudio", "--download-sections", f"*{a:.2f}-{b:.2f}",
+                    "--force-keyframes-at-cuts", "-o", base + ".%(ext)s", f"https://www.youtube.com/watch?v={video_id}"],
+                   check=True, timeout=300, capture_output=True)
+    src = next(os.path.join(out_dir, f) for f in os.listdir(out_dir)
+               if f.startswith(os.path.basename(base)) and not f.endswith(".wav"))
+    subprocess.run(["ffmpeg", "-loglevel", "error", "-y", "-i", src, "-ac", "1", "-ar", "16000", wav], check=True,
+                   timeout=120)
+    return wav
+
+
+def second_pass(wav, model="gpt-4o-transcribe-diarize", key=None):
+    """The OpenAI transcription of the audio: {"text", "segments": [{"speaker", "start", "end", "text"}], "model"}."""
+    if key is None:
+        from providers import env_value
+        key = env_value(ENV, "OPENAI_API_KEY")
+    boundary = uuid.uuid4().hex
+    fields = {"model": model, "response_format": "diarized_json" if "diarize" in model else "json"}
+    if "diarize" in model:
+        fields["chunking_strategy"] = "auto"
+    body = b""
+    for k, v in fields.items():
+        body += f"--{boundary}\r\nContent-Disposition: form-data; name=\"{k}\"\r\n\r\n{v}\r\n".encode()
+    body += (f"--{boundary}\r\nContent-Disposition: form-data; name=\"file\"; filename=\"{os.path.basename(wav)}\"\r\n"
+             f"Content-Type: audio/wav\r\n\r\n").encode() + open(wav, "rb").read() + f"\r\n--{boundary}--\r\n".encode()
+    req = urllib.request.Request("https://api.openai.com/v1/audio/transcriptions", data=body,
+                                 headers={"Authorization": "Bearer " + (key or ""),
+                                          "Content-Type": f"multipart/form-data; boundary={boundary}"})
+    d = json.loads(urllib.request.urlopen(req, timeout=300).read())
+    segs = [{"speaker": s.get("speaker"), "start": s.get("start"), "end": s.get("end"), "text": s.get("text", "")}
+            for s in d.get("segments") or []]
+    return {"text": d.get("text") or " ".join(s["text"] for s in segs), "segments": segs, "model": model}
+
+
+def critical_tokens(text):
+    """The tokens law L-v 2 protects: numbers (canonical values), negations, and proper names (capitalised words
+    after the first word)."""
+    toks = canon.canon_tokens(text)
+    nums = [t for t in toks if _NUM.match(t)]
+    negs = [t for t in toks if t in NEGATIONS or t.endswith("n't")]
+    words = re.findall(r"(?<![\w$])[A-Za-z][A-Za-z'’-]*", text or "")     # never the K of '16K' (a number's unit)
+    names = sorted({w for i, w in enumerate(words) if i > 0 and w[0].isupper() and w not in ("I",)})
+    return {"numbers": nums, "negations": negs, "names": names}
+
+
+def compare(selected_text, second_text):
+    """Every critical token of the selected sentences must be read the same in the second pass (canonical form).
+    -> {"ok", "disagree": {"numbers": [...], "negations": [...], "names": [...]}}."""
+    a, b = critical_tokens(selected_text), canon.canon_tokens(second_text)
+    bset = set(b)
+    dis = {"numbers": [n for n in a["numbers"] if n not in bset],
+           "negations": [n for n in a["negations"] if n not in bset],
+           "names": [n for n in a["names"] if not set(canon.canon_tokens(n)) <= bset]}
+    return {"ok": not any(dis.values()), "disagree": dis, "critical": a}
+
+
+def speaker_turns(second, start_rel, end_rel):
+    """Speakers of the second pass's segments overlapping [start_rel, end_rel] (seconds inside the window): one label
+    = no change inside; more = a change (law L-v 1); none = not measured."""
+    sp = [s["speaker"] for s in second["segments"]
+          if s.get("start") is not None and s.get("end") is not None and s["end"] > start_rel and s["start"] < end_rel]
+    labels = sorted({x for x in sp if x})
+    return {"labels": labels, "turn_change_inside": (len(labels) > 1) if labels else None}
+
+
+def verify_segment(video_id, start, end, text, work_dir):
+    """Both checks for one selected segment -> a record (the second pass's text kept as evidence)."""
+    wav = audio_window(video_id, start, end, work_dir)
+    sec = second_pass(wav)
+    cmp_ = compare(text, sec["text"])
+    turns = speaker_turns(sec, PAD_S, PAD_S + (end - start))
+    return {"video_id": video_id, "start": start, "end": end, "model": sec["model"], "second_pass_text": sec["text"],
+            "transcript_ok": cmp_["ok"], "disagree": cmp_["disagree"], "critical": cmp_["critical"],
+            "speakers": turns, "audio": os.path.basename(wav)}
