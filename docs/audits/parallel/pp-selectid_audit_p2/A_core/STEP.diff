+def integrity(router, pk, sources, writer_vendor, a_by, levels, now=None):
+    """The hard gates: VO fidelity (deterministic incl. PRICE_NOW + blind verdict), DUPLICATE, context integrity
+    (A precomputed, B, C), runtime. -> dict with ok and every violation."""
+    segs_v = {s["moment_id"]: {"speaker": s["channel"], "names": [s["channel"]], "video_id": s["video_id"],
+                               "text": s["text"]} for s in pk["segments"]}
+    lines = [{"slot": x["slot"], "text": x["text"], "cites": x["cites"]} for x in pk["lines"]]
+    fid = VF.check(router, segs_v, lines, writer_vendor, current_levels=levels)
+    dup = duplicates(pk)
+    a_use = None if a_by is None else {s["label"]: dict(a_by[s["moment_id"]], label=s["label"]) for s in pk["segments"]}
+    ctx_ = CI.check_contexts(router, pk, CI.contexts_from_sources(pk, sources, now), writer_vendor, a_by=a_use)
+    rt_ok = RUNTIME_S[0] <= pk["runtime_s_estimate"] <= RUNTIME_S[1]
+    return {"fidelity": fid, "duplicates": dup, "context": ctx_, "runtime_ok": rt_ok,
+            "fid_ok": fid["ok"] and not dup, "ok": fid["ok"] and not dup and ctx_["ok"] and rt_ok}
+
