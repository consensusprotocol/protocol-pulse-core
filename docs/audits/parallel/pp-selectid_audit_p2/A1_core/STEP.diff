+            text = self.llm._post(p, max_tokens, seed)
+        except (OSError, http.client.HTTPException, ValueError, KeyError, TypeError) as e:
+            raise Unavailable(f"ollama: {type(e).__name__}") from None
+        return text, {"in": 0, "out": 0}, time.time() - t0
