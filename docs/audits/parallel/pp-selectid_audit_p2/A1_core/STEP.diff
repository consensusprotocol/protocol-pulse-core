+        if len(prompt) / 2.5 + max_tokens > sm.LLM_CTX:       # Ollama keeps the tail and drops the instructions
+            raise RequestRejected(f"prompt over the local context {sm.LLM_CTX}")
+        p = (system + "\n\n" + prompt) if system else prompt
+        t0 = time.time()
