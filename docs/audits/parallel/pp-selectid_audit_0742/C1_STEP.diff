+        for kw in ({"rep_sp": "s1"}, {"rep": ("Bo-",)}, {"rep": ("Bit",)}):             # not a self-repair at all
+            t = run(words(**kw))
+            self.assertFalse(t["edges"]["cuttable"], kw)
