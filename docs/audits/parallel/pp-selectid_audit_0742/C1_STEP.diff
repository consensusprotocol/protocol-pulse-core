+            ws = [{"text": before, "start": 0.4, "end": 0.8, "speaker": "s0"}]
+            ws += [{"text": r, "start": 1.30 - 0.2 * (len(rep) - 1 - k), "end": 1.42 - 0.2 * (len(rep) - 1 - k),
