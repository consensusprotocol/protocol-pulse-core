+                   for k, t in enumerate(text.lower().split())]
+            return ws + [{"text": "Okay,", "start": 6.0, "end": 6.2, "speaker": "s1"}]
+
+        class R:
+            def __init__(self, ws):
+                self.ws = ws
+
