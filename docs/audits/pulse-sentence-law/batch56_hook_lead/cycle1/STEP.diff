+def hook_lead_at(src, c):
+    """(genuine lead ms, onset s) of the audio as cut at `c`: G17a's own measure (head_tail), on LEVEL_WINDOW_S."""
+    import tempfile
+    with tempfile.TemporaryDirectory() as d:
