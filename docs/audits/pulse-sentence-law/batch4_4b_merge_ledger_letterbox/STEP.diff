+                ans[m], err = None, f"{type(e).__name__}: {e}"
+        good = all(a == "no" for a in ans.values())
+        ok = ok and good
+        rows.append({**f, "asked": True, "answers": ans, "ok": good, **({"error": err} if err else {})})
+    return ok, rows
