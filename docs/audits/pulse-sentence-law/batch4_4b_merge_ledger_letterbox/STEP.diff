+def _entry(run, vid, chunks, quote, headline="h"):
+    import story_semantics as sm
+    return {"run": run, "headline": headline, "evidence": [{"video_id": vid, "chunk_ids": chunks, "quote": quote,
+                                                             "quote_tokens": sm._norm(quote).split()}]}
