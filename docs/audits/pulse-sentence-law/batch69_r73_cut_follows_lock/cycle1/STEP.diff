+        SL._ruling73(head, {}, words_at(("Bitcoin", 14.0, 14.5)), 0, 0)
+        self.assertEqual((head["cut_lo"], head["cut_hi"], head["cut"], head["cuttable"]), (13.6, 13.6, 13.6, True))
