+        self.assertEqual(RA.package_formats({"formats": ["16x9"]}), ["16x9"])
+        self.assertEqual(RA.package_formats({"formats": ["16x9", "9x16"]}), ["16x9", "9x16"])
+        for bad in (["9x16"], ["16x9", "16x9"], [], "16x9", None, ("16x9",), [16]):
