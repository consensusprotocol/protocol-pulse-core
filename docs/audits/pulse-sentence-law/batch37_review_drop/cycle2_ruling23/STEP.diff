+    with open(p) as f:
+        rep = json.load(f)
+    rep["_run_dir"] = run_dir
+    out = []
+    for fmt in ("16x9", "9x16"):
+        rows = (rep.get("rows") or {}).get(fmt) or {}
+        notes = (rep.get("notes") or {}).get(fmt) or {}
