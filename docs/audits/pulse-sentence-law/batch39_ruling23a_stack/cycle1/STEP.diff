+                        if str(sh.get("class", "")).startswith("stack")})
+        if kinds:
+            lines.append(f"9:16 STACK {label} ({seg.get('channel')}): {', '.join(kinds)}: two speakers in two panels, "
+                         f"one above the other; each face is centred in its own panel")
+    return ("\n" + "\n".join(lines)) if lines else ""
