+
+def sha256(path):
+    import hashlib
+    h = hashlib.sha256()
+    with open(path, "rb") as f:
+        for b in iter(lambda: f.read(1 << 20), b""):
+            h.update(b)
+    return h.hexdigest()
+
+
+MEASURED = ("edl.json", "out/segment.mp4", "out/segment_vertical.mp4", "qa/concat_manifest_16x9.json",
+            "qa/concat_manifest_9x16.json")
