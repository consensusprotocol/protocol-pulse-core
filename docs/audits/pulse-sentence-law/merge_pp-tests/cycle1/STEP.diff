+    assert ok is False, why
+    ok, why = ES.adjacent_admissible(H.fake_llm([raw]), Q_EVENT, "Bitcoin fell to 74,000 dollars today.",
+                                     "That 74,000 dollar level is the one to watch.")
+    assert ok is False, why
