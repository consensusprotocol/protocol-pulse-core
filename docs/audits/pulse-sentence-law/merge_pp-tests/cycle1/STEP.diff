+
+def passing_rows(ra):
+    rows = {fmt: {k: "PASS" for k in ra.INVENTORY[fmt] | ra.MONITORING[fmt]} for fmt in ra.FORMATS}
+    for fmt in ra.FORMATS:
+        for k, allowed in ra.NONBLOCKING[fmt].items():
+            rows[fmt][k] = sorted(allowed)[0]
+    return rows
