+@pytest.fixture
+def cut_run(cut_template, tmp_path, monkeypatch):
+    import select_passages as SP
+    rd = str(tmp_path / "run")
+    shutil.copytree(cut_template["dir"], rd)
+    monkeypatch.setattr(SP, "subprocess", H.FakeYtDlp())
+    return {**cut_template, "dir": rd}
