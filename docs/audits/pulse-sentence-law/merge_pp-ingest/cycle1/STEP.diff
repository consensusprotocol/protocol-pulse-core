index 00000000..7a47077c
--- /dev/null
+++ b/pipeline/ingest/contract.py
@@ -0,0 +1,176 @@
+"""pipeline/ingest/contract.py: sentence ids and the pp.moment/1 contract.
+
+The ids are pp-selectid's (MOMENTS / PACKAGE INPUT CONTRACT v0, docs/audits/parallel/pp-selectid_STATE.md):
+  tokens    = select_by_id.tokens_from_record(record)        ('word' | 'segment', tokens)
+  sentences = eligibility.split_sentences(tokens)            whole sentences as token-index ranges
+  text      = eligibility.spoken(tokens[w0..w1])             verbatim as spoken (law L-h)
+  moment_id = sha256('video_id|transcript_sha256|w0|w1')[:20]
+The defining modules are IMPORTED, never copied: from pipeline/ once merged, else read-only from the pp-selectid
+worktree (PP_SELECTID_PIPELINE). fingerprint() digests their defining functions and their output on a fixed probe, so a
+moment mined under another definition is detected and re-derived (verify_line), never silently re-read.
+"""
+import hashlib
+import importlib.util
+import inspect
+import json
+import os
+import sys
+
+from . import config  # noqa: F401  (puts pipeline/ on sys.path)
+
+SCHEMA = "pp.moment/1"
+SELECTID_DEFAULT = "/home/ultron/worktrees/pp-selectid/pipeline"
+SPEAKER_MARKERS = (">>", "&gt;&gt;")
+
+
+class ContractUnavailable(RuntimeError):
+    pass
+
+
+_MODS = None
+
+
+def _load_file(name, path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    if spec is None or not os.path.exists(path):
+        raise ContractUnavailable(f"{name}: {path} not found")
+    mod = importlib.util.module_from_spec(spec)
+    sys.modules[name] = mod
+    try:
+        spec.loader.exec_module(mod)
+    except Exception:
+        sys.modules.pop(name, None)
+        raise
+    return mod
+
+
+def modules():
+    """(eligibility, select_by_id, origin). Raises ContractUnavailable: no ids without the contract's definitions."""
+    global _MODS
+    if _MODS is None:
+        try:
+            import eligibility
+            import select_by_id
+            origin = os.path.dirname(os.path.abspath(select_by_id.__file__))
+        except ImportError:
+            d = os.environ.get("PP_SELECTID_PIPELINE", SELECTID_DEFAULT)
+            try:
+                eligibility = _load_file("eligibility", os.path.join(d, "eligibility.py"))
+                select_by_id = _load_file("select_by_id", os.path.join(d, "select_by_id.py"))
+            except ContractUnavailable:
+                raise
+            except Exception as e:
+                raise ContractUnavailable(f"contract modules in {d} failed to import: {type(e).__name__}: {e}")
+            origin = d
+        for fn in ("tokens_from_record",):
+            if not callable(getattr(select_by_id, fn, None)):
+                raise ContractUnavailable(f"select_by_id.{fn} missing")
+        for fn in ("split_sentences", "spoken", "eligible", "Source", "Span", "Context"):
+            if not hasattr(eligibility, fn):
+                raise ContractUnavailable(f"eligibility.{fn} missing")
+        _MODS = (eligibility, select_by_id, origin)
+    return _MODS
+
+
+PROBE_RECORD = {"segments": [
+    {"start": 0.0, "end": 4.0, "text": "It went from above $81 ,000 to below $75 ,000 in the U .S. market."},
+    {"start": 4.0, "end": 7.5, "text": "&gt;&gt; Dr. Smith said the S&amp;P fell 1 .3% ... then what?"},
+    {"start": 7.5, "end": 9.0, "text": "Bitcoin held. And e.g. miners sold"}]}
+
+
+_FP = None
+
+
+def fingerprint():
+    global _FP
+    if _FP is None:
+        E, S, origin = modules()
+        import sentence_law
+        ts = config.ts()
+        h = hashlib.sha256()
+        for f in (S.tokens_from_record, E.split_sentences, E.spoken, sentence_law.is_terminal, ts.read_text):
+            h.update(inspect.getsource(f).encode())
+        h.update(ts._SPLIT_TOKEN.pattern.encode())
+        timing, toks = S.tokens_from_record(PROBE_RECORD)
+        sents = E.split_sentences(toks)
+        h.update(json.dumps([timing, [list(s) for s in sents],
+                             [E.spoken(toks[a:b + 1]) for a, b in sents]]).encode())
+        _FP = h.hexdigest()[:24]
+    return _FP
+
+
+def moment_id(video_id, transcript_sha256, w0, w1):
+    return hashlib.sha256(f"{video_id}|{transcript_sha256}|{w0}|{w1}".encode()).hexdigest()[:20]
+
+
+def record_tokens(rec):
+    _, S, _ = modules()
+    return S.tokens_from_record(rec)
+
+
+def sentences(rec):
+    """Every sentence of a record: {'k','w0','w1','text','start','end','complete'}. complete = it ends on a terminal
+    mark (the record's last words may form an unfinished sentence: never offered as a moment)."""
+    E, _, _ = modules()
+    import sentence_law
+    timing, toks = record_tokens(rec)
+    out = []
+    for k, (w0, w1) in enumerate(E.split_sentences(toks)):
+        out.append({"k": k, "w0": w0, "w1": w1, "text": E.spoken(toks[w0:w1 + 1]),
+                    "start": toks[w0].get("start"), "end": toks[w1].get("end"),
+                    "complete": bool(sentence_law.is_terminal(toks[w1].get("word")))})
+    return timing, toks, out
+
+
+def turn_change_inside(toks, w0, w1):
+    """True when a caption speaker marker ('>>') starts a token after the span's first: a measured speaker change.
+    None otherwise: the absence of a marker is not a measurement (auto captions carry none; law L-m)."""
+    for t in toks[w0 + 1:w1 + 1]:
+        if str(t.get("word") or "").startswith(SPEAKER_MARKERS):
+            return True
+    return None
+
+
+def source_for(rec, meta, timing, toks):
+    """eligibility.Source of a whole caption / word record of a VOD (file_head: the record starts at the media's
+    first word; vod: the fetcher established an upload or a finished stream, never a Short / live / upcoming)."""
+    E, _, _ = modules()
+    return E.Source(video_id=rec["video_id"], channel_id=meta.get("channel_id"), channel_name=meta.get("channel_name"),
+                    published_at=meta.get("published_at"), transcript_sha256=rec.get("transcript_sha256"),
+                    transcript_method=rec.get("transcript_method"), tokens=toks, timing=timing, file_head=True,
+                    vod=True, title=meta.get("exact_title") or "")
+
+
+def eligibility_at_mining(src, registry, k0, k1, now):
+    """eligibility.eligible(Span, role clip) as judged at mining time; the packager re-judges with its own clock and
+    word timing. A failure to evaluate is recorded as a failed evaluation, never as ok."""
+    E, _, _ = modules()
+    try:
+        res = E.eligible(E.Span(src, k0, k1), E.Context(now=now, registry=registry, role="clip"))
+        return {"role": "clip", "ok": bool(res.ok), "reasons": [[r.name, r.detail] for r in res.reasons],
+                "targets_missed": list(res.facts.get("targets_missed") or [])}
+    except Exception as e:
+        return {"role": "clip", "ok": False, "reasons": [["not_evaluated", f"{type(e).__name__}: {e}"[:300]]],
+                "targets_missed": []}
+
+
+def verify_line(line, rec):
+    """A ledger line still names its text under the current definitions: (True, '') or (False, why)."""
+    try:
+        timing, toks, sents = sentences(rec)
+    except Exception as e:
+        return False, f"record unreadable: {type(e).__name__}: {e}"
+    if rec.get("transcript_sha256") != line.get("transcript_sha256"):
+        return False, "transcript sha differs"
+    k0, k1 = line["sentences"]
+    if not (0 <= k0 <= k1 < len(sents)):
+        return False, f"sentences {k0}..{k1} out of range"
+    w0, w1 = sents[k0]["w0"], sents[k1]["w1"]
+    if [w0, w1] != list(line["words"]):
+        return False, f"words {line['words']} != {[w0, w1]} under the current definitions"
+    E, _, _ = modules()
+    if E.spoken(toks[w0:w1 + 1]) != line["text"]:
+        return False, "text differs under the current definitions"
+    if moment_id(line["video_id"], line["transcript_sha256"], w0, w1) != line["moment_id"]:
+        return False, "moment_id differs"
+    return True, ""
diff --git a/pipeline/ingest/coverage.py b/pipeline/ingest/coverage.py
new file mode 100644
index 00000000..eeae8020
--- /dev/null
+++ b/pipeline/ingest/coverage.py
@@ -0,0 +1,121 @@
+"""pipeline/ingest/coverage.py: the daily coverage check ("never miss the day's most relevant content" as a number).
+
+An INDEPENDENT listing of every watched channel at check time (RSS when its canary answers, else the uploads
+playlist; never the watcher's own queue) gives the videos published in the last `hours`. Each is matched to the
+queue: mined (its moments, possibly none, are in the ledger) or not, with the reason. A channel whose listing fails is
+UNMEASURED: its videos are never counted as covered (law L-m). Shorts are reported apart (never mined by policy).
+"""
+import json
+import os
+import time
+from datetime import datetime, timezone
+
+from . import config
+from . import queue as Q
+from . import watch
+
+RSS_CACHE_S = 900             # YouTube's feeds answer Cache-Control: public, max-age=900 (measured 2026-11-12)
+
+REASONS = {
+    Q.SHORT: "a Short: never mined (policy, L-u)",
+    Q.UPCOMING: "upcoming stream: not started",
+    Q.LIVE: "stream still live / post-live: re-probed every 20 min",
+    Q.CAPTIONS_PENDING: "no English captions yet: re-probed",
+    Q.NO_CAPTIONS: "no English captions 48 h after publish: needs the pipeline's Whisper",
+    Q.TOO_LONG: "longer than the 6 h VOD ceiling",
+    Q.UNAVAILABLE: "unavailable (private / removed / members-only / age-gated)",
+    Q.DUPLICATE: "re-upload of an earlier video",
+    Q.OPTOUT: "channel opted out / no longer watched",
+    Q.SEEN_OLD: "dated outside the 72 h window at probe",
+    Q.DISCOVERED: "discovered, not yet probed",
+    Q.PROBE_RETRY: "probe failed: retrying",
+    Q.PROBING: "being probed",
+    Q.TRANSCRIBED: "transcribed: waiting to be mined",
+    Q.MINING: "being mined",
+    Q.MINE_WAIT: "every back-end failed or refused: retrying",
+}
+
+
+def check(q, gate, hours=24, now_ts=None, rss=None, chans=None):
+    now_ts = now_ts or time.time()
+    if chans is None:
+        _, chans = watch.registry()
+    optout, oerr = watch.optouts()
+    rss = watch.rss_canary(chans) if rss is None else rss
+    rep = {"at": config.iso(), "hours": hours, "listing": "rss" if rss else "uploads_playlist", "channels": len(chans),
+           "unmeasured_channels": [], "published": 0, "shorts": 0, "eligible": 0, "mined": 0, "missed": [],
+           "per_channel": {}, "optout_error": oerr}
+    for c in chans:
+        cid, name = c["channel_id"], c.get("display_name")
+        try:
+            if rss:
+                st, ents, _ = watch.rss_list(cid)
+                ents = [{"video_id": e["video_id"], "title": e["title"], "ts": watch._parse_iso(e["published"]).timestamp(),
+                         "url": e["url"]} for e in ents]
+            else:
+                ents = watch.playlist_list(gate, cid)
+        except watch.ListError as e:
+            rep["unmeasured_channels"].append({"channel": name, "channel_id": cid, "error": f"{e.kind}: {e.detail[:120]}"})
+            continue
+        pc = rep["per_channel"].setdefault(name, {"published": 0, "mined": 0, "missed": 0, "shorts": 0})
+        for e in ents:
+            v = q.video(e["video_id"])
+            pts = (v or {}).get("published_ts") or e.get("ts")
+            if pts is None or not (now_ts - hours * 3600 <= float(pts) <= now_ts + 600):
+                continue
+            rep["published"] += 1
+            pc["published"] += 1
+            state = (v or {}).get("state")
+            is_short = state == Q.SHORT or "/shorts/" in (e.get("url") or "")
+            if is_short:
+                rep["shorts"] += 1
+                pc["shorts"] += 1
+                continue
+            rep["eligible"] += 1
+            if state in (Q.MINED, Q.MINED_PARTIAL):
+                rep["mined"] += 1
+                pc["mined"] += 1
+                if state == Q.MINED_PARTIAL:
+                    rep["missed"].append(_row(e, c, v, "mined partially: some windows failed on every back-end"))
+                continue
+            pc["missed"] += 1
+            age_min = (now_ts - float(pts)) / 60
+            if v is None and age_min * 60 <= config.POLL_S + config.POLL_JITTER_S + RSS_CACHE_S:
+                why = (f"published {age_min:.0f} min ago: inside the discovery window (a {config.POLL_S // 60} min poll "
+                       f"+ YouTube's RSS cache, max-age {RSS_CACHE_S // 60} min), not listed yet")
+            elif v is None:
+                why = "never discovered by the watcher (a watcher miss)"
+            else:
+                why = REASONS.get(state, state) + (f" ({v.get('reason')})" if v.get("reason") else "")
+            rep["missed"].append(_row(e, c, v, why))
+    rep["coverage"] = None if not rep["eligible"] else round(rep["mined"] / rep["eligible"], 4)
+    rep["measured"] = not rep["unmeasured_channels"]
+    return rep
+
+
+def _row(e, c, v, why):
+    return {"channel": c.get("display_name"), "video_id": e["video_id"], "title": (v or {}).get("title") or e.get("title"),
+            "published_at": (v or {}).get("published_at") or (
+                datetime.fromtimestamp(float(e["ts"]), timezone.utc).isoformat() if e.get("ts") else None),
+            "state": (v or {}).get("state"), "reason": why}
+
+
+def write(rep, out_dir):
+    os.makedirs(out_dir, exist_ok=True)
+    day = rep["at"][:10]
+    with open(os.path.join(out_dir, f"{day}.json"), "w") as f:
+        json.dump(rep, f, indent=1)
+    cov = "unmeasured" if rep["coverage"] is None else f"{rep['coverage'] * 100:.1f} %"
+    md = [f"# Coverage {rep['at']} (last {rep['hours']} h, listing: {rep['listing']})", "",
+          f"- partner videos published: {rep['published']} ({rep['shorts']} Shorts, never mined by policy)",
+          f"- long-form videos: {rep['eligible']}; mined (in the ledger): {rep['mined']}; coverage {cov}",
+          f"- channels unmeasured (listing failed): {len(rep['unmeasured_channels'])}"
+          + (" -> this report is NOT a full measurement" if rep["unmeasured_channels"] else ""), "",
+          "| channel | video | published | state | reason |", "|---|---|---|---|---|"]
+    for m in rep["missed"]:
+        md.append(f"| {m['channel']} | {m['video_id']} | {m['published_at']} | {m['state']} | {m['reason']} |")
+    for u in rep["unmeasured_channels"]:
+        md.append(f"| {u['channel']} | (listing failed) | | | {u['error']} |")
+    with open(os.path.join(out_dir, f"{day}.md"), "w") as f:
+        f.write("\n".join(md) + "\n")
+    return os.path.join(out_dir, f"{day}.md")
diff --git a/pipeline/ingest/fetch.py b/pipeline/ingest/fetch.py
new file mode 100644
index 00000000..92ab0ba2
--- /dev/null
+++ b/pipeline/ingest/fetch.py
@@ -0,0 +1,238 @@
+"""pipeline/ingest/fetch.py: probe one queued video and, once it is a captioned VOD, store its captions.
+
+Captions go into the staging store through transcript_store's own writer (fetch_captions -> _make_record -> _store,
+attempts via _log_attempt), so the record format is the pipeline's by construction. meta.json is written once, ONLY
+when the video is a VOD with English captions listed (INGEST-FAIL-01: a meta written while live froze 46 videos);
+meta_record() has every key transcript_store.ensure_meta writes (tests/ingest/test_fetch.py checks parity) and dates a
+livestream VOD by its stream start (INGEST-FAIL-03). No Whisper, no GPU.
+"""
+import hashlib
+import json
+import os
+from datetime import datetime, timezone
+
+from . import config
+from . import queue as Q
+from .watch import BACKFILL_H, ListError
+
+UNAVAILABLE_MARKS = ("Private video", "Video unavailable", "This video has been removed", "members-only",
+                     "Join this channel", "Sign in to confirm your age", "This video is no longer available",
+                     "account associated with this video has been terminated")
+UNAVAILABLE_RETRY_S = 6 * 3600
+UNAVAILABLE_MAX_TRIES = 4
+PROBE_RETRY_S = (300, 900, 1800, 3600)
+
+
+def _dt(epoch):
+    return datetime.fromtimestamp(float(epoch), timezone.utc) if isinstance(epoch, (int, float)) else None
+
+
+def publish_time(j, rss_published=None):
+    """(aware ISO, source): a livestream VOD is dated by its stream start (release_timestamp); an upload by RSS when
+    listed there, else yt-dlp's timestamp. None when nothing is measured."""
+    if j.get("live_status") in ("was_live", "post_live", "is_live") and _dt(j.get("release_timestamp")):
+        return _dt(j["release_timestamp"]).isoformat(), "yt-dlp release_timestamp (stream start)"
+    if rss_published:
+        return rss_published, "youtube_rss"
+    if _dt(j.get("timestamp")):
+        return _dt(j["timestamp"]).isoformat(), "yt-dlp timestamp"
+    if _dt(j.get("release_timestamp")):
+        return _dt(j["release_timestamp"]).isoformat(), "yt-dlp release_timestamp"
+    return None, None
+
+
+def captions_listed(j):
+    manual = sorted((j.get("subtitles") or {}).keys())
+    auto = sorted(k for k in (j.get("automatic_captions") or {}) if k in ("en", "en-orig"))
+    return manual, auto
+
+
+def meta_record(j, chan, published_at, published_source, rss_title=None):
+    """transcript_store.ensure_meta's record (same keys, same derivations) plus release_timestamp, timestamp,
+    media_type and the writer's name."""
+    ts = config.ts()
+    manual, auto = captions_listed(j)
+    vid = j["id"]
+    return {
+        "schema": ts.SCHEMA, "video_id": vid, "canonical_url": ts.canonical_url(vid),
+        "channel_id": j.get("channel_id") or chan.get("channel_id"),
+        "channel_name": chan.get("display_name") or j.get("channel"),
+        "channel_name_youtube": j.get("channel"),
+        "exact_title": rss_title or j.get("title"), "title_youtube": j.get("title"),
+        "published_at": published_at, "published_at_source": published_source,
+        "duration": j.get("duration"), "live_status": j.get("live_status"),
+        "description": (j.get("description") or "")[:4000],
+        "captions_manual": manual, "captions_auto_en": auto,
+        "metadata_fetched_at": ts.now_iso(), "metadata_tool": "yt-dlp -J",
+        "release_timestamp": j.get("release_timestamp"), "timestamp": j.get("timestamp"),
+        "media_type": j.get("media_type"), "written_by": "pipeline.ingest.fetch",
+    }
+
+
+def title_canon(title):
+    import canon
+    return " ".join(canon.canon_tokens(title or ""))
+
+
+def text_fingerprint(rec):
+    """sha256 of the WHOLE record read as spoken (canonical tokens): a re-upload of the same speech. Not a prefix
+    (audit cycle 2 consensus, three reviewers): a prefix would call every video of a channel with a long standard intro
+    or sponsor read a re-upload of its first one and never mine it."""
+    import canon
+    ts = config.ts()
+    toks = canon.canon_tokens(ts.read_text(" ".join(s["text"] for s in rec["segments"])))
+    if len(toks) < 50:
+        return None                          # too little text to call two videos the same
+    return hashlib.sha256(" ".join(toks).encode()).hexdigest()[:32]
+
+
+def probe(gate, video_id):
+    """(json, None) or (None, (kind, detail)). kind: unavailable | rate_limited | error."""
+    try:
+        r = gate.run(["-J", "--skip-download", "--ignore-no-formats-error",
+                      f"https://www.youtube.com/watch?v={video_id}"], timeout=120)
+    except ListError as e:
+        return None, (e.kind, e.detail)
+    try:
+        j = json.loads(r.stdout)
+        if isinstance(j, dict) and j.get("id") == video_id:
+            return j, None
+    except ValueError:
+        pass
+    err = (r.stderr or "")[-400:]
+    if any(m in err for m in UNAVAILABLE_MARKS):
+        return None, ("unavailable", err)
+    return None, ("error", err or f"yt-dlp rc {r.returncode}")
+
+
+def _retry_at(now_ts, tries):
+    return now_ts + PROBE_RETRY_S[min(tries, len(PROBE_RETRY_S) - 1)]
+
+
+def _caption_retry_at(now_ts, published_ts, tries):
+    if tries < len(config.CAPTION_RETRY_S):
+        return now_ts + config.CAPTION_RETRY_S[tries]
+    return now_ts + 7200
+
+
+def process(q, gate, v, chan, optout, now_ts=None):
+    """Advance one due video by one step. Returns the new state."""
+    now_ts = now_ts or q.clock()
+    vid, tries = v["video_id"], int(v.get("tries") or 0)
+    if chan is None:
+        q.set_state(vid, Q.OPTOUT, next_at=now_ts + 10 ** 9, reason="channel no longer watched (registry)")
+        return Q.OPTOUT
+    if chan["channel_id"] in optout:
+        q.set_state(vid, Q.OPTOUT, next_at=now_ts + 10 ** 9, reason="channel in pipeline/optout.json")
+        return Q.OPTOUT
+    j, err = probe(gate, vid)
+    if err:
+        kind, detail = err
+        if kind == "unavailable":
+            final = tries + 1 >= UNAVAILABLE_MAX_TRIES
+            q.set_state(vid, Q.UNAVAILABLE, next_at=now_ts + (10 ** 9 if final else UNAVAILABLE_RETRY_S),
+                        tries=tries + 1, reason=f"yt-dlp: {detail[-200:]}")
+            return Q.UNAVAILABLE
+        q.set_state(vid, Q.PROBE_RETRY, next_at=now_ts + (gate.open_for() or 0) + PROBE_RETRY_S[0]
+                    if kind == "rate_limited" else _retry_at(now_ts, tries), tries=tries + 1,
+                    reason=f"{kind}: {detail[-200:]}")
+        return Q.PROBE_RETRY
+    if j.get("channel_id") and j["channel_id"] != chan["channel_id"]:
+        q.set_state(vid, Q.UNAVAILABLE, next_at=now_ts + 10 ** 9,
+                    reason=f"channel mismatch: video belongs to {j.get('channel_id')}")
+        return Q.UNAVAILABLE
+    rss_pub = _dt(v.get("listing_ts")).isoformat() if v.get("discovered_via") == "rss" and _dt(v.get("listing_ts")) \
+        else None
+    pub, pub_src = publish_time(j, rss_published=rss_pub)
+    pub_ts = datetime.fromisoformat(pub).timestamp() if pub else None
+    live, media = j.get("live_status"), j.get("media_type")
+    common = dict(published_at=pub, published_ts=pub_ts, published_source=pub_src, media_type=media,
+                  live_status=live, duration=j.get("duration"), title=v.get("title") or j.get("title"))
+    if media == "short":
+        q.set_state(vid, Q.SHORT, next_at=now_ts + 10 ** 9, reason="a Short: never mined (L-u)", **common)
+        return Q.SHORT
+    if live == "is_upcoming":
+        start = j.get("release_timestamp")
+        nxt = max(float(start) + 900, now_ts + 600) if isinstance(start, (int, float)) else now_ts + config.UPCOMING_REPROBE_S
+        q.set_state(vid, Q.UPCOMING, next_at=nxt, tries=tries + 1, reason=f"upcoming (scheduled {pub})", **common)
+        return Q.UPCOMING
+    if live in ("is_live", "post_live"):
+        q.set_state(vid, Q.LIVE, next_at=now_ts + config.LIVE_REPROBE_S, tries=tries + 1,
+                    reason=f"{live}: re-probed every {config.LIVE_REPROBE_S // 60} min (meta.json not written)", **common)
+        return Q.LIVE
+    if pub_ts is None:
+        q.set_state(vid, Q.PROBE_RETRY, next_at=_retry_at(now_ts, tries), tries=tries + 1,
+                    reason="no publish time measured", **common)
+        return Q.PROBE_RETRY
+    if now_ts - pub_ts > BACKFILL_H * 3600:
+        q.set_state(vid, Q.SEEN_OLD, next_at=now_ts + 10 ** 9,
+                    reason=f"published {pub}: older than the {BACKFILL_H} h window", **common)
+        return Q.SEEN_OLD
+    dur = j.get("duration")
+    if not isinstance(dur, (int, float)) or dur <= 0:
+        q.set_state(vid, Q.PROBE_RETRY, next_at=_retry_at(now_ts, tries), tries=tries + 1,
+                    reason="no duration measured", **common)
+        return Q.PROBE_RETRY
+    if dur > config.VOD_MAX_S:
+        q.set_state(vid, Q.TOO_LONG, next_at=now_ts + 10 ** 9,
+                    reason=f"duration {dur:.0f} s > {config.VOD_MAX_S} s", **common)
+        return Q.TOO_LONG
+    tc = title_canon(j.get("title"))
+    dup, why = q.find_duplicate(vid, title_canon=tc, duration=dur)
+    if dup:
+        q.set_state(vid, Q.DUPLICATE, next_at=now_ts + 10 ** 9, duplicate_of=dup, title_canon=tc,
+                    reason=f"re-upload of {dup}: {why}", **common)
+        return Q.DUPLICATE
+    manual, auto = captions_listed(j)
+    if not (any(k.startswith("en") for k in manual) or auto):
+        if now_ts - pub_ts > config.CAPTION_DEADLINE_H * 3600:
+            q.set_state(vid, Q.NO_CAPTIONS, next_at=now_ts + 10 ** 9, title_canon=tc,
+                        reason=f"no English captions {config.CAPTION_DEADLINE_H} h after publish (needs the pipeline's "
+                               "Whisper)", **common)
+            return Q.NO_CAPTIONS
+        q.set_state(vid, Q.CAPTIONS_PENDING, next_at=_caption_retry_at(now_ts, pub_ts, tries), tries=tries + 1,
+                    title_canon=tc, reason="VOD without English captions yet", **common)
+        return Q.CAPTIONS_PENDING
+    return _store_captions(q, gate, v, chan, j, common, tc, now_ts, tries)
+
+
+def _store_captions(q, gate, v, chan, j, common, tc, now_ts, tries):
+    ts = config.ts()
+    vid = v["video_id"]
+    paths = config.paths()
+    vdir = ts._vdir(vid)
+    os.makedirs(vdir, exist_ok=True)
+    mpath = os.path.join(vdir, "meta.json")
+    if os.path.exists(mpath):
+        with open(mpath) as f:
+            meta = json.load(f)
+    else:
+        meta = meta_record(j, chan, common["published_at"], common["published_source"],
+                           rss_title=v.get("title") if v.get("discovered_via") == "rss" else None)
+    existing = ts.canonical_transcript(vid)
+    if existing is None:
+        with gate.sem:
+            status, rec = ts.fetch_captions(meta, os.path.join(paths["work"], "captions_tmp"))
+        ts._log_attempt(vid, step="captions", status=status, writer="pipeline.ingest")
+        if status != "ok":
+            nxt = now_ts + 1800 if status == "throttled" else _caption_retry_at(now_ts, common["published_ts"], tries)
+            q.set_state(vid, Q.CAPTIONS_PENDING, next_at=nxt, tries=tries + 1, title_canon=tc,
+                        reason=f"captions {status}", **common)
+            return Q.CAPTIONS_PENDING
+        if not os.path.exists(mpath):
+            ts._write_once(mpath, meta)
+        ts._store(rec)
+        existing = ts.canonical_transcript(vid)
+    elif not os.path.exists(mpath):
+        ts._write_once(mpath, meta)
+    fp = text_fingerprint(existing)
+    dup, why = q.find_duplicate(vid, text_fp=fp)
+    if dup:
+        q.set_state(vid, Q.DUPLICATE, next_at=now_ts + 10 ** 9, duplicate_of=dup, title_canon=tc, text_fp=fp,
+                    transcript_sha256=existing["transcript_sha256"], transcript_method=existing["transcript_method"],
+                    reason=f"re-upload of {dup}: {why}", **common)
+        return Q.DUPLICATE
+    q.set_state(vid, Q.TRANSCRIBED, next_at=now_ts, title_canon=tc, text_fp=fp,
+                transcript_sha256=existing["transcript_sha256"], transcript_method=existing["transcript_method"],
+                transcribed_at=config.iso(), transcribed_ts=now_ts, reason=None, **common)
+    return Q.TRANSCRIBED
