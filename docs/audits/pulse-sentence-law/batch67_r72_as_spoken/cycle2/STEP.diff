+            c = json.load(f)
+        if c.get("source_file_sha256") == sha:
+            return c["words"], 0.0
+    words, usd = pinned._second_recogniser_words(a["path"])
+    with open(p + ".tmp", "w") as f:
+        json.dump({"source_file_sha256": sha, "usd": usd, "words": words}, f)
+    os.replace(p + ".tmp", p)
+    return words, usd
