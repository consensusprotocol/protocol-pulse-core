+                    pid = prompt_id(r["prompt"], r["max_tokens"], r["seed"])
+                    out = os.path.join(ROOT, "results", f"{r['request_id']}.{pid}.json")
+                    os.makedirs(os.path.dirname(out), exist_ok=True)
