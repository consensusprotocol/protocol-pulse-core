+def _field(o, key, kind, allowed=None, nonempty=False, lo=None, hi=None):
+    """One field of a model reply, strictly (red-team B): exact type (an int is never a bool or a string, a list
+    is a list), an enumerated value, a non-empty string, a number in range. Raises ValueError: the call failed."""
+    if not isinstance(o, dict):
+        raise ValueError("reply is not a JSON object")
+    v = o.get(key)
+    ok = {"int": type(v) is int, "bool": type(v) is bool, "str": isinstance(v, str), "list": isinstance(v, list),
+          "num": type(v) in (int, float)}[kind]
+    if not ok:
+        raise ValueError(f"{key} must be {kind}, got {type(v).__name__}")
+    if allowed is not None and v not in allowed:
+        raise ValueError(f"{key} {v!r} not in {allowed}")
+    if nonempty and not (v.strip() if isinstance(v, str) else v):
+        raise ValueError(f"{key} is empty")
+    if (lo is not None and v < lo) or (hi is not None and v > hi):
+        raise ValueError(f"{key} {v!r} outside [{lo}, {hi}]")
+    return v
+
+
