diff --git a/pipeline/test_edl_rules.py b/pipeline/test_edl_rules.py
index bb598e0b..6258d046 100644
--- a/pipeline/test_edl_rules.py
+++ b/pipeline/test_edl_rules.py
@@ -944,6 +944,66 @@ class TestShoutoutHookChannel(unittest.TestCase):
         self.assertEqual(channels[0], "SharedChan")
 
 
+class TestR4Moments(unittest.TestCase):
+    """Law L-q (orchestrator 2026-11-12 '06:00'): R4 for a package of type 'moments' ONLY: VO share <= 40 %, one VO line
+    per slot (after the hook, after each clip, after the LAST clip), the estimated runtime inside 60-70 s (hard, L-o);
+    story-type and untyped EDLs keep the old R4. Must-fail: VO share 41 %, runtime 59.9 and 70.1 s, a line with no
+    slot. Runtime = hook + clips + VO (words / 2.5 + 1.0 s pre-roll each) + 14.30 s tail."""
+
+    @staticmethod
+    def edl(hook, clips, intro_words, bridges, t="moments"):
+        e = {"hook": {"duration": hook, "channel": "H"},
+             "clips": [{"index": i, "duration": d, "channel": f"C{i}"} for i, d in enumerate(clips, 1)],
+             "vo": {"intro": " ".join(["w"] * intro_words) if intro_words else None,
+                    "bridges": [{"text": " ".join(["w"] * n), "after_clip": a} for n, a in bridges]}}
+        if t is not None:
+            e["package_type"] = t
+        return e
+
+    def test_vo_share_41_percent_fails_and_40_passes(self):
+        ok, why = rule_r4(self.edl(8.78, [10, 10], 30, [(15, 1)]))       # 20.0 s VO of 48.78 s = 41.0 %
+        self.assertFalse(ok)
+        self.assertIn("VO=41.0%", why)
+        self.assertNotIn("outside 60-70", why)                             # 63.08 s: only the share fails
+        ok, why = rule_r4(self.edl(9.383, [10, 10], 30, [(15, 1)]))      # 20.0 s of 49.383 s = 40.5 %: the limit
+        self.assertFalse(ok, why)                                          # is 40, not 41
+        self.assertIn("VO=40.5%", why)
+        ok, why = rule_r4(self.edl(10.0, [10, 10], 30, [(15, 1)]))       # 20.0 s of 50.0 s = 40.0 %
+        self.assertTrue(ok, why)
+
+    def test_runtime_59_9_and_70_1_fail_60_and_70_pass(self):
+        for hook, want in ((15.6, False), (15.7, True), (25.7, True), (25.8, False)):   # + 20 clips + 10 VO + 14.3
+            ok, why = rule_r4(self.edl(hook, [10, 10], 16, [(4, 2)]))
+            self.assertEqual(ok, want, why)
+            if not want:
+                self.assertIn("outside 60-70 s", why)
+
+    def test_a_vo_line_with_no_slot_fails(self):
+        for bridges in ([(5, 0)], [(5, 3)], [(5, 1), (5, 1)], [(5, 2), (5, 1)], [(5, "1")], [(5, None)], [(5, True)],
+                        [(5, 1.0)]):
+            ok, why = rule_r4(self.edl(20.0, [14, 14], 10, bridges))
+            self.assertFalse(ok, bridges)
+            self.assertIn("has no slot", why, bridges)
+        ok, why = rule_r4({**self.edl(20.0, [14, 14], 10, []), "vo": {"intro": "a b", "bridges": [{"text": "x"}]}})
+        self.assertIn("has no slot", why)
+
+    def test_a_line_after_each_clip_including_the_last_has_a_slot(self):
+        ok, why = rule_r4(self.edl(14.0, [12, 12], 10, [(5, 1), (5, 2)]))   # VO 4+2+... = 10 s; 38 + 10 + 14.3
+        self.assertTrue(ok, why)
+
+    def test_word_caps_are_unchanged(self):
+        self.assertIn("intro=31 words", rule_r4(self.edl(20.0, [14, 14], 31, []))[1])
+        self.assertIn("bridge 1=21 words", rule_r4(self.edl(20.0, [14, 14], 5, [(21, 1)]))[1])
+
+    def test_story_type_and_untyped_edls_keep_the_old_rule(self):
+        for t in ("story", None, "Moments"):
+            e = self.edl(10.0, [10, 10], 30, [(15, 1)], t=t)              # 40 % share: old rule max 25 %
+            ok, why = rule_r4(e)
+            self.assertFalse(ok, t)
+            self.assertIn("max 25%", why, t)
+            self.assertNotIn("moments", why, t)
+
+
 if __name__ == "__main__":
     unittest.main(verbosity=2)
 
