         fn = src[src.index("def prerender_clips(run_dir, table):"):]
         self.assertLess(fn.index('gpu0.swap_to("nvenc")'), fn.index("_prerender_isolated(run_dir, table)"))
 
+    def test_no_module_forces_gpu0_over_an_explicit_cpu_request(self):
+        """E-FAIL-053: render16 (and, found next, render_vertical and qa_gates) set CUDA_VISIBLE_DEVICES=0 on import,
+        overriding a CPU session's ''. Any assignment of the variable must sit under the explicit-CPU guard."""
+        import re
+        bad = []
+        for f in self.FILES:
+            lines = open(f).read().splitlines()
+            for i, line in enumerate(lines):
+                if re.search(r"os\.environ\[['\"]CUDA_VISIBLE_DEVICES['\"]\]\s*=(?!=)", line):
+                    guard = lines[i - 1] if i else ""
+                    if 'not in ("", "-1")' not in guard:
+                        bad.append(f"{os.path.relpath(f, PIPELINE)}:{i + 1}")
+        self.assertEqual(bad, [])
+
