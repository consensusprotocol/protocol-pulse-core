+#!/usr/bin/env python3
+"""pipeline/gpu0.py — law L-r GPU0 NEVER SURPRISES A RUN (orchestrator 2026-11-12 '01:55' B; PBX on the pinned run's
+out-of-memory: "let's make sure that never happens again").
+
+ONE OWNER. GPU0 belongs to whoever holds the lease: an exclusive flock on the lease file (/tmp/pulse_gpu0.lease; the
+environment variable PP_GPU0_LEASE overrides it), the holder recorded in the file. Entry points take it:
+scripts/pulse_check_run.sh on fd 8 for the whole run (preflight and run_fresh inherit that descriptor), and run_fresh,
+preflight, backtest and GPU test sessions with lease() when started on their own. held() is true in a process that
+took it with lease(), or that inherited a descriptor whose open file description holds the flock (a second flock on
+that description succeeds; on any other description it fails while the lock is held). Every load onto GPU0 goes
+through swap_to(), which calls require(): no lease, no load.
+
+ONE MODEL AT A TIME. swap_to(key) is the one way anything gets onto GPU0. It refuses a foreign GPU0 process, unloads
+everything else that is resident (this process's Model objects, every model on the GPU0 Ollama via keep_alive=0,
+confirmed on /api/ps), collects garbage and empties torch's cache, then waits until nvidia-smi shows GPU0 free >=
+REQUIREMENT_MIB[key] + MARGIN_MIB. A Model (whisper(), model()) loads through swap_to on first use, is deleted
+by any later swap, and loads again through swap_to when it is used again; its calls run inside guard().
+
+STOPS. Every refusal is a Gpu0Stop, a BaseException, so no `except Exception` between a load and the stage runner can
+turn it into another error ('transcription failed' hid an out-of-memory on Nov 12, E-FAIL-052): GpuOOM (a CUDA
+out-of-memory inside guard()), Gpu0Foreign (GPU0 memory held by a process that is not this run's), LeaseMissing (a
+load without the lease), LeaseBusy (another owner holds the lease), Gpu0NotFree (the memory did not come free in
+time), Gpu0Unreadable (nvidia-smi or the Ollama listener cannot be read: never read as 'nothing there'). run_fresh's
+stage runner owns the one retry of an out-of-memory and turns every other stop into a HOLD carrying the real cause."""
+import contextlib
+import fcntl
+import gc
+import json
+import os
+import re
+import subprocess
+import sys
+import threading
+import time
+import urllib.error
+import urllib.request
+
+DEFAULT_LEASE = "/tmp/pulse_gpu0.lease"
+OLLAMA_HOST = "127.0.0.1:11434"            # the GPU0 Ollama listener (story_semantics.LLM_HOST)
+MARGIN_MIB = 1024
+# Peak GPU0 memory one load needs (MiB, its process's CUDA context included): the peak measured on this host's 24564 MiB
+# GPU0 by pipeline/measure_gpu0.py on 2026-11-12 (600 s of speech; DoD 'L-r GPU0 requirements'), rounded up by ~5%;
+# swap_to adds MARGIN_MIB. A key missing here can never be loaded.
+REQUIREMENT_MIB = {
+    "ollama:gemma3:27b": 20600,            # resident 20548-20559 (nvidia-smi 01:43 / 01:55 ET); measured peak 19241
+    "whisper:large-v3": 6000,              # measured 5657 (beam 5, word timestamps, 600 s)
+    "whisper:large-v3:batched": 9600,      # measured 9145 (batch 16 full: 600 s)
+    "whisper:distil-large-v3:batched": 5700,   # measured 5401 (batch 16 full: 600 s)
+    "whisper:medium": 2800,                # measured 2649
+    "embedder": 1500,                      # measured 1379 (bge-base fp16, 64 x 512 tokens)
+    "resemblyzer": 850,                    # measured 775
+    "nvenc": 600,                          # measured 536 (one 1080x1920 h264_nvenc encode at a time)
+}
+WAIT_S = 180
+
+
+class Gpu0Stop(BaseException):
+    """A GPU0 refusal. A BaseException on purpose: it passes every `except Exception` up to the stage runner."""
+
+
+class GpuOOM(Gpu0Stop):
+    """A CUDA out-of-memory raised inside guard() (the original exception is its __cause__)."""
+
+
+class Gpu0Foreign(Gpu0Stop):
+    """GPU0 memory is held by a process that is not this run's."""
+
+
+class LeaseMissing(Gpu0Stop):
+    """A GPU0 load in a process that does not hold the lease."""
+
+
+class LeaseBusy(Gpu0Stop):
+    """Another owner holds the lease."""
+
+
+class Gpu0NotFree(Gpu0Stop):
+    """The memory a load needs did not come free in time."""
+
+
+class Gpu0Unreadable(Gpu0Stop):
+    """nvidia-smi or the GPU0 Ollama listener cannot be read."""
+
+
+_lock = threading.RLock()
+_own = {}           # lease path -> {"file", "pid", "depth"}: this process's own lease() holdings
+_resident = []      # Model objects loaded on GPU0 by this process
+_events = []        # every swap's evidence (run_fresh copies it into PROVENANCE)
+_gen = [0]          # bumped whenever the resident set changes (LocalLLM re-swaps only when it moved)
+
+
+# ── the lease ──
+
+def lease_path():
+    return os.path.realpath(os.environ.get("PP_GPU0_LEASE", DEFAULT_LEASE))
+
+
+def _fds_on(target):
+    out = []
+    for name in os.listdir("/proc/self/fd"):
+        try:
+            if os.path.realpath(os.readlink(f"/proc/self/fd/{name}")) == target:
+                out.append(int(name))
+        except (OSError, ValueError):
+            continue
+    return out
+
+
+def held():
+    """True when this process holds the lease (see the module docstring)."""
+    target = lease_path()
+    h = _own.get(target)
+    if h and h["pid"] == os.getpid():
+        return True
+    for fd in _fds_on(target):
+        try:
+            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
+            return True
+        except OSError:
+            continue
+    return False
+
+
+def holder():
+    """The recorded holder {"pid", "owner", "since"} while the lease is held, None when it is free."""
+    try:
+        f = open(lease_path(), "a+")
+    except OSError as e:
+        return {"pid": None, "owner": f"lease file unreadable ({type(e).__name__})"}
+    with f:
+        try:
+            fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except OSError:
+            return _record(f)
+        fcntl.flock(f, fcntl.LOCK_UN)              # this probe's own private description only
+        return None
+
+
+def _record(f):
+    try:
+        rec = json.loads(os.pread(f.fileno(), 4096, 0).decode(errors="replace") or "{}")
+    except (OSError, ValueError):
+        rec = {}
+    return rec if isinstance(rec, dict) else {}
+
+
+@contextlib.contextmanager
+def lease(owner, wait_s=0.0, poll_s=0.2):
+    """Hold the lease for the block. Re-entrant where this process already holds it (its own lease() or an inherited
+    descriptor); otherwise acquired within wait_s, or LeaseBusy naming the holder. Released by closing the
+    descriptor (never LOCK_UN): a child that was handed it keeps GPU0 until it closes it too."""
+    target = lease_path()
+    if held():
+        h = _own.get(target)
+        if h and h["pid"] == os.getpid():
+            h["depth"] += 1
+            try:
+                yield
+            finally:
+                h["depth"] -= 1
+        else:
+            yield
+        return
+    f = open(target, "a+")
+    t0 = time.time()
+    while True:
+        try:
+            fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
+            break
+        except OSError:
+            if time.time() - t0 >= wait_s:
+                rec = _record(f)
+                f.close()
+                raise LeaseBusy(f"the GPU0 lease is held by {rec.get('owner', 'an unrecorded owner')} "
+                                f"(pid {rec.get('pid')})") from None
+            time.sleep(poll_s)
+    f.seek(0)
+    f.truncate()
+    json.dump({"pid": os.getpid(), "owner": owner, "since": time.time()}, f)
+    f.flush()
+    _own[target] = {"file": f, "pid": os.getpid(), "depth": 1}
+    try:
+        yield
+    finally:
+        _own.pop(target, None)
+        f.close()
+
+
+def require(what):
+    """No lease, no load; and GPU0 only (GPU1 is quarantined)."""
+    if os.environ.get("CUDA_VISIBLE_DEVICES") != "0":
+        raise LeaseMissing(f"{what}: GPU0 loads need CUDA_VISIBLE_DEVICES=0 (it is "
+                           f"{os.environ.get('CUDA_VISIBLE_DEVICES')!r}; GPU1 is quarantined)")
+    if not held():
+        raise LeaseMissing(f"{what}: a GPU0 load without the GPU0 lease (law L-r: no lease, no load); "
+                           f"holder: {holder()}")
+
+
+# ── what is on GPU0 ──
+
+def _smi(args, timeout=15):
+    try:
+        r = subprocess.run(["nvidia-smi", *args], capture_output=True, text=True, timeout=timeout)
+    except (OSError, subprocess.TimeoutExpired) as e:
+        raise Gpu0Unreadable(f"nvidia-smi: {type(e).__name__}") from None
+    if r.returncode != 0:
+        raise Gpu0Unreadable(f"nvidia-smi exit {r.returncode}: {r.stderr.strip()[:200]}")
+    return r.stdout
+
+
+def memory():
+    """(used_mib, total_mib) of GPU index 0."""
+    out = _smi(["-i", "0", "--query-gpu=memory.used,memory.total", "--format=csv,noheader,nounits"])
+    try:
+        used, total = (int(x) for x in out.strip().split(","))
+    except ValueError:
+        raise Gpu0Unreadable(f"nvidia-smi memory line unreadable: {out.strip()[:80]!r}") from None
+    return used, total
+
+
+def processes():
+    """[(pid, name, MiB)] of every compute process on GPU index 0."""
+    uuid = _smi(["-i", "0", "--query-gpu=uuid", "--format=csv,noheader"]).strip()
+    if not uuid:
+        raise Gpu0Unreadable("nvidia-smi names no GPU 0")
+    out = []
+    for line in _smi(["--query-compute-apps=pid,gpu_uuid,used_memory,process_name",
+                      "--format=csv,noheader,nounits"]).strip().splitlines():
+        p = [x.strip() for x in line.split(",", 3)]
+        if len(p) == 4 and p[1] == uuid and p[0].isdigit():
+            out.append((int(p[0]), os.path.basename(p[3]), int(p[2]) if p[2].isdigit() else None))
+    return out
+
+
+def describe(procs):
+    return ", ".join(f"pid {p} {n} {m} MiB" for p, n, m in procs) or "nothing"
+
+
+def _parent(pid):
+    with open(f"/proc/{pid}/stat") as f:
+        return int(f.read().rsplit(")", 1)[1].split()[1])
+
+
+def _ancestors():
+    out, pid = set(), os.getpid()
+    while pid > 1:
+        try:
+            pid = _parent(pid)
+        except (OSError, ValueError, IndexError):
+            break
+        out.add(pid)
+    return out
+
+
+def _descendants():
+    out, todo = set(), [os.getpid()]
+    while todo:
+        p = todo.pop()
+        try:
+            tids = os.listdir(f"/proc/{p}/task")
+        except OSError:
+            continue
+        for tid in tids:
+            try:
+                with open(f"/proc/{p}/task/{tid}/children") as f:
+                    kids = [int(x) for x in f.read().split()]
+            except (OSError, ValueError):
+                continue
+            for k in kids:
+                if k not in out:
+                    out.add(k)
+                    todo.append(k)
+    return out
+
+
+def _ollama_pids():
+    port = OLLAMA_HOST.rsplit(":", 1)[1]
+    try:
+        r = subprocess.run(["ss", "-ltnpH", f"sport = :{port}"], capture_output=True, text=True, timeout=10)
+        serve = {int(p) for p in re.findall(r"pid=(\d+)", r.stdout)}
+        kids = set()
+        for p in serve:
+            k = subprocess.run(["pgrep", "-P", str(p)], capture_output=True, text=True, timeout=10)
+            kids |= {int(x) for x in k.stdout.split()}
+    except (OSError, subprocess.TimeoutExpired) as e:
+        raise Gpu0Unreadable(f"cannot read the GPU0 Ollama listener: {type(e).__name__}") from None
+    return serve | kids
+
+
+def foreign():
+    """GPU0 compute processes that are not this run's: anything but this process, its ancestors (the wrapper that
+    holds the lease) and descendants, and the GPU0 Ollama listener with its runners (whose models every swap
+    unloads)."""
+    ours = {os.getpid()} | _ancestors() | _descendants() | _ollama_pids()
+    return [p for p in processes() if p[0] not in ours]
+
+
+# ── the GPU0 Ollama ──
+
+def _ollama(path, body=None, timeout=30):
+    req = urllib.request.Request(f"http://{OLLAMA_HOST}{path}",
+                                 data=None if body is None else json.dumps(body).encode(),
+                                 headers={"Content-Type": "application/json"})
+    return json.loads(urllib.request.urlopen(req, timeout=timeout).read() or b"{}")
+
+
+def ollama_loaded():
+    """Names of the models resident on the GPU0 Ollama ([] when nothing listens there)."""
+    try:
+        return [m["name"] for m in _ollama("/api/ps").get("models", [])]
+    except urllib.error.URLError as e:
+        if isinstance(getattr(e, "reason", None), ConnectionRefusedError):
+            return []
+        raise Gpu0Unreadable(f"Ollama {OLLAMA_HOST} /api/ps: {e}") from None
+    except (OSError, ValueError, KeyError, TypeError) as e:
+        raise Gpu0Unreadable(f"Ollama {OLLAMA_HOST} /api/ps: {type(e).__name__}: {e}") from None
+
+
+def _ollama_unload(keep=None, wait_s=60):
+    names = [n for n in ollama_loaded() if n != keep]
+    for n in names:
+        try:
+            _ollama("/api/generate", {"model": n, "keep_alive": 0}, timeout=120)
+        except (OSError, ValueError) as e:
+            raise Gpu0NotFree(f"Ollama would not unload {n}: {type(e).__name__}: {e}") from None
+    t0 = time.time()
+    while True:
+        left = [n for n in ollama_loaded() if n != keep]
+        if not left:
+            return names
+        if time.time() - t0 > wait_s:
+            raise Gpu0NotFree(f"Ollama still holds {left} {wait_s}s after keep_alive=0")
+        time.sleep(1)
+
+
+# ── swaps ──
+
+def generation():
+    return _gen[0]
+
+
+def events():
+    return list(_events)
+
+
+def _empty_caches():
+    gc.collect()
+    torch = sys.modules.get("torch")
+    if torch is not None:
+        try:
+            if torch.cuda.is_initialized():
+                torch.cuda.empty_cache()
+        except Exception:
+            pass
+
+
+def _ollama_key(key):
+    return key[len("ollama:"):] if key.startswith("ollama:") else None
+
+
+def swap_to(key, wait_s=WAIT_S, poll_s=2.0):
+    """Make GPU0 ready for `key` and nothing else this run can unload (see the module docstring). Returns the
+    evidence it recorded. Raises a Gpu0Stop."""
+    require(f"swap_to({key})")
+    if key not in REQUIREMENT_MIB:
+        raise Gpu0NotFree(f"{key}: no measured GPU0 requirement (gpu0.REQUIREMENT_MIB): never loaded")
+    with _lock:
+        f = foreign()
+        if f:
+            raise Gpu0Foreign(f"GPU0 memory is held by a process that is not this run's: {describe(f)}")
+        ev = {"key": key, "at": time.time(), "before": memory(), "unloaded": []}
+        for m in [m for m in _resident if m.key != key]:
+            m.unload()
+            ev["unloaded"].append(m.key)
+        name = _ollama_key(key)
+        ev["unloaded"] += [f"ollama:{n}" for n in _ollama_unload(keep=name)]
+        already = name in ollama_loaded() if name else any(m.key == key for m in _resident)
+        _empty_caches()
+        need = REQUIREMENT_MIB[key] + MARGIN_MIB
+        t0 = time.time()
+        while True:
+            used, total = memory()
+            if already or total - used >= need:
+                break
+            if time.time() - t0 > wait_s:
+                raise Gpu0NotFree(f"{key}: GPU0 has {total - used} MiB free {wait_s}s after the swap, needs {need} "
+                                  f"({REQUIREMENT_MIB[key]} + margin {MARGIN_MIB}); on GPU0: {describe(processes())}")
+            time.sleep(poll_s)
+        if not already:
+            _gen[0] += 1
+        ev.update(after=[used, total], free_mib=total - used, already_resident=already,
+                  waited_s=round(time.time() - t0, 1))
+        _events.append(ev)
+        return ev
+
+
+def release_all(wait_s=WAIT_S, idle_mib=None, poll_s=2.0):
+    """Unload everything this process put on GPU0 (its Models, every GPU0 Ollama model), then wait until nvidia-smi
+    shows GPU0 at most idle_mib used (default: the smallest requirement, i.e. nothing loaded but CUDA contexts).
+    Returns evidence; raises Gpu0NotFree naming every GPU0 process when it does not come free."""
+    idle_mib = min(REQUIREMENT_MIB.values()) if idle_mib is None else idle_mib
+    with _lock:
+        ev = {"at": time.time(), "before": memory(), "unloaded": []}
+        for m in list(_resident):
+            m.unload()
+            ev["unloaded"].append(m.key)
+        ev["unloaded"] += [f"ollama:{n}" for n in _ollama_unload()]
+        _empty_caches()
+        _gen[0] += 1
+        t0 = time.time()
+        while True:
+            used, total = memory()
+            if used <= idle_mib:
+                ev.update(after=[used, total], waited_s=round(time.time() - t0, 1))
+                return ev
+            if time.time() - t0 > wait_s:
+                raise Gpu0NotFree(f"GPU0 still has {used} MiB used {wait_s}s after releasing everything this run "
+                                  f"owns (idle is <= {idle_mib}); on GPU0: {describe(processes())}")
+            time.sleep(poll_s)
+
+
+# ── out of memory ──
+
+_OOM = re.compile(r"out of memory|CUDA_ERROR_OUT_OF_MEMORY|cudaErrorMemoryAllocation|CUBLAS_STATUS_ALLOC_FAILED|"
+                  r"OutOfMemoryError", re.I)
+
+
+def is_oom(e):
+    """True for a CUDA / NVENC out-of-memory, read from the exception, its type and any captured stderr/output."""
+    if isinstance(e, GpuOOM):
+        return True
+    parts = [type(e).__name__, str(e)]
+    for attr in ("stderr", "output"):
+        v = getattr(e, attr, None)
+        if isinstance(v, bytes):
+            v = v.decode(errors="replace")
+        if isinstance(v, str):
+            parts.append(v[-4000:])
+    return bool(_OOM.search(" ".join(parts)))
+
+
+@contextlib.contextmanager
+def guard(what):
+    """A CUDA out-of-memory raised inside the block leaves it as GpuOOM (nothing can rename it on the way up)."""
+    try:
+        yield
+    except Gpu0Stop:
+        raise
+    except Exception as e:
+        if is_oom(e):
+            raise GpuOOM(f"{what}: CUDA out of memory ({type(e).__name__}: {str(e)[:300]})") from e
+        raise
+
+
+def guard_iter(it, what):
+    """Iterate a lazily decoding iterator (faster-whisper segments) with every step inside guard()."""
+    while True:
+        with guard(what):
+            try:
+                x = next(it)
+            except StopIteration:
+                return
+        yield x
+
+
+# ── the only GPU0 models ──
+
+class Model:
+    """A GPU0 object loaded only through swap_to (see the module docstring). get() returns the loaded object;
+    any attribute of it is reachable through the Model, a call running inside guard()."""
+
+    def __init__(self, key, build):
+        self.key, self._build, self._obj = key, build, None
+
+    def get(self):
+        with _lock:
+            if self._obj is None:
+                swap_to(self.key)
+                with guard(f"{self.key}: load"):
+                    self._obj = self._build()
+                _resident.append(self)
+            return self._obj
+
+    def unload(self):
+        with _lock:
+            self._obj = None
+            if self in _resident:
+                _resident.remove(self)
+
+    @property
+    def loaded(self):
+        return self._obj is not None
+
+    def __getattr__(self, name):
+        if name.startswith("_"):
+            raise AttributeError(name)
+        attr = getattr(self.get(), name)
+        if not callable(attr):
+            return attr
+        what = f"{self.key}: {name}"
+
+        def call(*a, **k):
+            with guard(what):
+                return attr(*a, **k)
+        return call
+
+    def __call__(self, *a, **k):
+        obj = self.get()
+        with guard(f"{self.key}: call"):
+            return obj(*a, **k)
+
+
+class Whisper(Model):
+    def transcribe(self, *a, **k):
+        obj = self.get()
+        with guard(f"{self.key}: transcribe"):
+            segments, info = obj.transcribe(*a, **k)
+        return guard_iter(iter(segments), f"{self.key}: decode"), info
+
+
+_models = {}
+
+
+def whisper(name, batched=False):
+    """The process's one faster-whisper model `name` (float16 on GPU0; batched = a BatchedInferencePipeline)."""
+    key = f"whisper:{name}" + (":batched" if batched else "")
+    with _lock:
+        if key not in _models:
+            def build():
+                from faster_whisper import WhisperModel
+                m = WhisperModel(name, device="cuda", compute_type="float16")
+                if batched:
+                    from faster_whisper import BatchedInferencePipeline
+                    m = BatchedInferencePipeline(model=m)
+                return m
+            _models[key] = Whisper(key, build)
+        return _models[key]
+
+
+def model(key, build):
+    """The process's one Model for `key` (a torch module, an encoder...): `build` makes the loaded object."""
+    with _lock:
+        if key not in _models:
+            _models[key] = Model(key, build)
+        return _models[key]
+
+
+# ── evidence ──
+
+class PeakSampler:
+    """GPU0 memory.used sampled every interval_s on a daemon thread; the peak per label (run_fresh: the stage)."""
+
+    def __init__(self, interval_s=1.0):
+        self.interval_s, self.label, self.peaks, self.errors = interval_s, None, {}, 0
+        self._stop = threading.Event()
+        self._thread = threading.Thread(target=self._run, daemon=True)
+
+    def start(self):
+        self._thread.start()
+        return self
+
+    def set(self, label):
+        self.label = label
+        self._sample()
+
+    def _sample(self):
+        try:
+            used, _ = memory()
+        except Gpu0Stop:
+            self.errors += 1
+            return
+        if self.label is not None:
+            self.peaks[self.label] = max(self.peaks.get(self.label, 0), used)
+
+    def _run(self):
+        while not self._stop.wait(self.interval_s):
+            self._sample()
+
+    def stop(self):
+        self._stop.set()
+        self._thread.join(timeout=5)
+        self._sample()
+        return dict(self.peaks)
