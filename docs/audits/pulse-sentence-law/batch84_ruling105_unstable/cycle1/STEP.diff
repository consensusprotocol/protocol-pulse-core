+                                                   for w, r in shorts]
+    sec = seconds(k)
+    res = pinned.unstable_second_reading(L[k], [t for _, _, t in dec], [t for _, _, t in sec])
+    return dict(res, token=L[k], decoder_readings=[{"at": w, "source": s, "token": t} for w, s, t in dec],
