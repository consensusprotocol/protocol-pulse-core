+    def test_a_moments_first_package_is_about_its_label_never_its_title(self):
+        """Law L-q / pp-selectid R7 item 4: the stand-alone subject of a moments-first EDL is the pin label; a pinned
+        or auto EDL keeps its story / angle subject (unchanged)."""
+        from run_fresh import stand_alone_subject
+        mf = {"topic": "bitcoin", "angle": "Pinned: Keep your keys off exchanges", "moments_package_sha256": "a" * 64}
+        self.assertEqual(stand_alone_subject(mf, {}), {"bitcoin", "btc"})
+        self.assertEqual(stand_alone_subject({**mf, "topic": "ethereum"}, {}), {"ethereum"})   # not widened
+        self.assertEqual(stand_alone_subject({**mf, "topic": ""}, {}), set())                 # fails closed
+        import stand_alone as SA
+        pinned = {k: v for k, v in mf.items() if k != "moments_package_sha256"}
+        self.assertEqual(stand_alone_subject(pinned, {}), SA.subject_terms("", pinned["angle"]))      # unchanged
+        self.assertIn("pinned", stand_alone_subject(pinned, {}))   # why a written title cannot be the subject
+        story = {"affected_object": "Binance hot wallet", "underlying_event": "hack"}
+        self.assertEqual(stand_alone_subject(pinned, story), SA.subject_terms("Binance hot wallet", "hack"))
+
