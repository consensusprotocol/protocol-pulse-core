+def stand_alone_subject(edl, story):
+    """The words every segment must use (stand_alone.subject_terms). A moments-first package (law L-q; pp-selectid
+    REQUESTS R7 item 4, 'its subject for a Bitcoin package is Bitcoin'): the pin's label, never its written title (the
+    pinned angle is 'Pinned: <title>'; the title is a package line its own VO-fidelity gate checked). Every other run,
+    unchanged: the selected story's object / event, else the EDL angle / topic."""
+    import stand_alone
+    if edl.get("moments_package_sha256"):
+        return stand_alone.subject_terms("", edl.get("topic", ""))
+    return stand_alone.subject_terms(story.get("affected_object", ""),
+                                     story.get("underlying_event") or edl.get("angle") or edl.get("topic", ""))
+
