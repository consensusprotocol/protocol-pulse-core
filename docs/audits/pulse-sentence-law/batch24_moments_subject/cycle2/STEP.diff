+def stand_alone_subject(edl, story):
+    """The words every segment must use (stand_alone.subject_terms). A moments-first package (law L-q; pp-selectid
+    REQUESTS R7 item 4, 'its subject for a Bitcoin package is Bitcoin'): its pin label, never its written title (the
+    pinned angle is 'Pinned: <title>'; the title is a package line its own VO-fidelity gate checked), and only a Bitcoin
+    label: any other label, or a moments marker that is not the 64-hex digest pinned.build_edl writes, is an EMPTY
+    subject, which fails closed (stand_alone.topical: no hook names it). Every other run, unchanged: the selected
+    story's object / event, else the EDL angle / topic."""
+    import stand_alone
+    if "moments_package_sha256" in edl:
+        sha = edl["moments_package_sha256"]
+        terms = stand_alone.subject_terms("", edl.get("topic") or "") \
+            if isinstance(sha, str) and re.fullmatch(r"[0-9a-f]{64}", sha) else set()
+        return terms if terms == {"bitcoin", "btc"} else set()
+    return stand_alone.subject_terms(story.get("affected_object", ""),
+                                     story.get("underlying_event") or edl.get("angle") or edl.get("topic", ""))
+
