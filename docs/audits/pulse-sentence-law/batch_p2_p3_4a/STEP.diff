+    def test_C_is_a_short_insert(self):
+        j = TR.plan(SEGS, CH, LT, "C")
+        self.assertEqual([(x["after"], x["kind"]) for x in j], [(0, "insert"), (1, "insert")])
+        self.assertLess(TR.WIPE_FRAMES / TR.FPS, 0.35)
