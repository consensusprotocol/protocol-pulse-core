+        e = self.entry(ATTESTED.upper().replace(".", ""))
+        self.assertEqual(e["outcome"], "no_difference", e)
+        self.assertEqual((e["scribe_usd"], self.heard), (0, []))
+
+    def test_the_word_pass_text_holds_as_the_render_held_it(self):
