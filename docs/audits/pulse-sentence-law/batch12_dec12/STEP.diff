+        print(f"    FAIL: t={out_time:.3f}s frame mismatch (audio ok, frame_sim={sim:.3f} < 0.3)")
+    else:
+        entry["reason"] = "frame comparison inconclusive"
+        print(f"    HOLD: t={out_time:.3f}s — frame comparison inconclusive")
+    return entry
+
