+            continue
+        drop = [k for k, w in enumerate(t) if w == "dollars" and k and re.fullmatch(r"\d+(\.\d+)?", t[k - 1])]
+        if a in drop:
+            continue
+        out[a - sum(1 for k in drop if k < a)] = set(x.get("readings") or [])
+    return out
+
+
+def diff(expected, heard, collapse=False, alts=None):
