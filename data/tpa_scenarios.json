          "description": "ETF net inflows >$500M/week for 4+ consecutive weeks",
          "sentinel_state_path": "etf.net_6h_usd",
          "threshold": 71428571,
          "comparison": "gte",
          "consecutive_required": 4,
          "consecutive_window_hours": 168,
          "probability_delta": 5.0,
          "decay_days": 30
        },
        {
          "signal_id": "S1_CME_OI",
          "description": "CME futures open interest at 6-month high",
          "sentinel_state_path": "etf.deribit_funding_rate",
          "threshold": 0.01,
          "comparison": "gte",
          "consecutive_required": 1,
          "consecutive_window_hours": 0,
          "probability_delta": 4.0,
          "decay_days": 30
