  },
  {
   "start": 585.776,
   "end": 586.556,
   "text": "Let me read that again."
  },
  {
   "start": 587.446,
   "end": 591.186,
   "text": "Bitcoin bottom four years ago to the exact day."
  },
  {
   "start": 591.576,
   "end": 594.876,
   "text": "I'm not saying the four -year cycles are going to last forever, but that's kind of uncanny."
  },
  {
